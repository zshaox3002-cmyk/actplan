<!-- pages/dashboard/index.wxml -->
<view class="page-container">
  <!-- DISABLED: import-export - 暂时禁用，保留备用
  <view class="data-menu-btn" bindtap="onDataMenuTap">
    <text class="data-menu-icon">⋮</text>
  </view>
  -->

  <!-- 周期选择栏 -->
  <view class="period-banner">
    <view class="period-selector" bindtap="onPeriodTap">
      <text class="period-label">{{periodLabel}}</text>
      <image class="period-arrow" src="/assets/icons/chevron-down.svg" mode="aspectFit" />
    </view>
    <text class="period-range">{{periodRange}}</text>
  </view>

  <!-- 周期下拉选项 -->
  <view class="period-dropdown" wx:if="{{showPeriodDropdown}}" catchtap="onDropdownMaskTap">
    <view class="period-dropdown-inner" catchtap="">
      <view class="period-option {{currentPeriod === 'week' ? 'active' : ''}}"
        catchtap="onPeriodSelect" data-period="week">
        <text>本周</text>
        <text class="period-check" wx:if="{{currentPeriod === 'week'}}">✓</text>
      </view>
      <view class="period-option {{currentPeriod === 'month' ? 'active' : ''}}"
        catchtap="onPeriodSelect" data-period="month">
        <text>本月</text>
        <text class="period-check" wx:if="{{currentPeriod === 'month'}}">✓</text>
      </view>
      <view class="period-option {{currentPeriod === 'quarter' ? 'active' : ''}}"
        catchtap="onPeriodSelect" data-period="quarter">
        <text>季度</text>
        <text class="period-check" wx:if="{{currentPeriod === 'quarter'}}">✓</text>
      </view>
      <view class="period-option {{currentPeriod === 'year' ? 'active' : ''}}"
        catchtap="onPeriodSelect" data-period="year">
        <text>年度</text>
        <text class="period-check" wx:if="{{currentPeriod === 'year'}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 2×2 指标卡 -->
  <view class="metrics-grid" wx:if="{{!isEmpty}}">
    <metric-card value="{{metrics.totalCustomers}}" label="客户总量" dotColor="#1A6FD4" />
    <metric-card value="{{metrics.newCustomers}}" label="本期新增" dotColor="#27AE60" />
    <metric-card value="{{metrics.visitCount}}" label="本期拜访" dotColor="#F39C12" />
    <metric-card value="{{metrics.appointmentCount}}" label="本期预约" dotColor="#8B5CF6" />
  </view>

  <!-- 空态引导 -->
  <view class="dashboard-empty" wx:if="{{isEmpty}}">
    <text class="empty-icon-text">📊</text>
    <text class="empty-title">开始管理你的客户</text>
    <text class="empty-desc">添加第一位客户后，这里将展示你的活动数据和业绩概览</text>
    <view class="empty-actions">
      <view class="empty-btn-primary" bindtap="onGoAddCustomer">
        <text>+ 添加第一位客户</text>
      </view>
      <view class="empty-btn-secondary" bindtap="onGoAddPlan">
        <text>或先创建拜访计划</text>
      </view>
    </view>
  </view>

  <!-- 苹果分布饼图 -->
  <view class="chart-section" wx:if="{{!isEmpty}}">
    <view class="section-title">
      <view class="title-bar"></view>
      <text>苹果分布</text>
    </view>
    <chart-pie data="{{appleData}}" />
  </view>

  <!-- 异议分布柱状图 -->
  <view class="chart-section" wx:if="{{!isEmpty}}">
    <view class="section-title">
      <view class="title-bar"></view>
      <text>异议分布</text>
    </view>
    <chart-bar data="{{objectionData}}" />
  </view>
</view>

