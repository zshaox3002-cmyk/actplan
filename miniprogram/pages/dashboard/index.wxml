<!-- pages/dashboard/index.wxml -->
<van-toast id="van-toast" />
<view class="page-container">

  <!-- 周期选择栏 -->
  <view class="period-banner">
    <view class="period-selector" bindtap="onPeriodTap">
      <text class="period-label">{{periodLabel}}</text>
      <image class="period-arrow {{showPeriodDropdown ? 'open' : ''}}" src="/assets/icons/chevron-down.svg" mode="aspectFit" />
    </view>
    <text class="period-range">{{periodRange}}</text>
  </view>

  <!-- 周期下拉选项 -->
  <view class="period-dropdown" wx:if="{{showPeriodDropdown}}" catchtap="onDropdownMaskTap">
    <view class="period-dropdown-inner" catchtap="">
      <view class="period-option {{currentPeriod === 'week' ? 'active' : ''}}" catchtap="onPeriodSelect" data-period="week">
        <text>本周</text>
        <text class="period-check" wx:if="{{currentPeriod === 'week'}}">✓</text>
      </view>
      <view class="period-option {{currentPeriod === 'month' ? 'active' : ''}}" catchtap="onPeriodSelect" data-period="month">
        <text>本月</text>
        <text class="period-check" wx:if="{{currentPeriod === 'month'}}">✓</text>
      </view>
      <view class="period-option {{currentPeriod === 'quarter' ? 'active' : ''}}" catchtap="onPeriodSelect" data-period="quarter">
        <text>季度</text>
        <text class="period-check" wx:if="{{currentPeriod === 'quarter'}}">✓</text>
      </view>
      <view class="period-option {{currentPeriod === 'year' ? 'active' : ''}}" catchtap="onPeriodSelect" data-period="year">
        <text>年度</text>
        <text class="period-check" wx:if="{{currentPeriod === 'year'}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 问候语 Hero 区域 -->
  <view class="hero-bar">
    <text class="hero-greeting">{{greetingPrefix}}</text>
    <text class="hero-subtext{{greetingWarn ? ' hero-subtext--warn' : ''}}">{{greetingSubtext}}</text>
  </view>

  <!-- 逾期警示 Banner -->
  <view class="overdue-banner" wx:if="{{overdueCount > 0}}" bindtap="onOverdueTap">
    <text class="overdue-banner-icon">⚠</text>
    <text class="overdue-banner-text">{{overdueCount}}条计划已逾期，去处理 ›</text>
  </view>

  <!-- 空态引导 -->
  <view class="dashboard-empty" wx:if="{{isEmpty}}">
    <text class="empty-icon-text">📋</text>
    <text class="empty-title">开始管理你的客户</text>
    <text class="empty-desc">添加第一位客户后，这里将展示今日拜访和跟进提醒</text>
    <view class="empty-actions">
      <van-button type="primary" block bindtap="onGoAddCustomer">+ 添加第一位客户</van-button>
      <van-button type="default" plain bindtap="onGoAddPlan">或先创建拜访计划</van-button>
    </view>
  </view>

  <block wx:if="{{!isEmpty}}">

    <!-- 今日拜访 -->
    <view class="section-title">
      <text>今日拜访</text>
      <view class="section-badge"><text>{{todayPlans.length}}</text></view>
    </view>

    <view class="today-empty" wx:if="{{todayPlans.length === 0}}">
      <text class="today-empty-text">今天没有安排拜访</text>
    </view>

    <van-cell-group custom-class="today-cell-group" wx:else>
      <van-cell wx:for="{{todayPlans}}" wx:key="id" use-label-slot border="{{false}}">
        <view slot="icon" class="today-time-slot">
          <text class="today-time" wx:if="{{item.plan_time}}">{{item.plan_time}}</text>
          <text class="today-time today-time-empty" wx:else>待定</text>
        </view>
        <view slot="title" class="today-cell-title">{{item.customerName}}</view>
        <view slot="label" class="today-cell-label">{{item.visit_way || '面对面'}} · {{item.customerStage}}</view>
        <van-button slot="right-icon" type="primary" size="small" catchtap="onExecutePlan" data-id="{{item.id}}">执行</van-button>
      </van-cell>
    </van-cell-group>

    <!-- 待跟进 Top -->
    <view id="follow-section" class="section-title">
      <text>待跟进</text>
    </view>

    <van-cell-group custom-class="follow-cell-group">
      <van-cell wx:for="{{pendingFollowUp}}" wx:key="id" use-label-slot bindtap="onFollowUpTap" data-id="{{item.id}}" border="{{false}}">
        <view slot="icon" class="follow-priority priority-{{item.priorityLevel}}">
          <text>{{item.priorityLevel}}</text>
        </view>
        <view slot="title" class="follow-name-row">
          <text class="follow-name">{{item.name}}</text>
          <text class="follow-stage stage-{{item.stageClass}}">{{item.stage}}</text>
        </view>
        <view slot="label" class="follow-label-col">
          <text class="follow-priority-label">{{item.priorityLabel}}</text>
          <view class="follow-next-row">
            <text wx:if="{{item.isOverdue}}" class="overdue-icon">⏰</text>
            <text class="follow-next {{item.isOverdue ? 'overdue' : ''}}">{{item.nextPlanText}}</text>
          </view>
        </view>
        <van-icon slot="right-icon" name="arrow" color="var(--color-text-placeholder)" />
      </van-cell>
    </van-cell-group>

    <!-- 本周进展 -->
    <view class="section-title">
      <text>{{periodLabel}}进展</text>
    </view>

    <view class="metrics-unified-card">
      <view class="metrics-grid">
        <view class="metric-item">
          <text class="metric-value {{metrics.newCustomers === 0 ? 'metric-value-zero' : ''}}">{{metrics.newCustomers}}</text>
          <text class="metric-label">新增客户</text>
        </view>
        <view class="metric-item">
          <text class="metric-value {{metrics.visitCount === 0 ? 'metric-value-zero' : ''}}">{{metrics.visitCount}}</text>
          <text class="metric-label">拜访次数</text>
        </view>
        <view class="metric-item">
          <text class="metric-value {{metrics.appointmentCount === 0 ? 'metric-value-zero' : ''}}">{{metrics.appointmentCount}}</text>
          <text class="metric-label">预约计划</text>
        </view>
        <view class="metric-item">
          <text class="metric-value {{metrics.dealCustomers === 0 ? 'metric-value-zero' : ''}}">{{metrics.dealCustomers}}</text>
          <text class="metric-label">本期成交</text>
        </view>
      </view>
    </view>

    <!-- 客户阶段漏斗 -->
    <view class="section-title">
      <text>客户阶段</text>
    </view>

    <view class="funnel-list">
      <view class="funnel-item" wx:for="{{stageFunnel}}" wx:key="stage">
        <text class="funnel-stage">{{item.stage}}</text>
        <view class="funnel-bar-wrap">
          <view class="funnel-bar" wx:if="{{item.count > 0}}" style="width: {{(item.count / funnelMax * 100)}}%; background: {{item.barColor}};"></view>
        </view>
        <text class="funnel-count">{{item.count}}</text>
      </view>
    </view>

    <view class="page-bottom-pad"></view>

  </block>

</view>
