<!-- pages/dashboard/index.wxml -->
<van-toast id="van-toast" />
<view class="page-container">

  <!-- 问候语 Hero 区域 -->
  <view class="hero-bar">
    <text class="hero-greeting">{{greetingPrefix}}</text>
    <text class="hero-subtext{{greetingWarn ? ' hero-subtext--warn' : ''}}">{{greetingSubtext}}</text>
  </view>

  <!-- KPI 三格 -->
  <view class="kpi-row">
    <view class="kpi-card {{kpiOverdue > 0 ? 'kpi-danger' : ''}}">
      <text class="kpi-num">{{kpiOverdue}}</text>
      <text class="kpi-label">逾期未做</text>
    </view>
    <view class="kpi-card">
      <text class="kpi-num">{{kpiPending}}</text>
      <text class="kpi-label">待执行计划</text>
    </view>
    <view class="kpi-card kpi-success">
      <text class="kpi-num">{{kpiMonthDeal}}</text>
      <text class="kpi-label">本月签单</text>
    </view>
  </view>

  <!-- 今日要做 -->
  <view class="section-title">
    <text>今日要做</text>
    <view class="section-badge" wx:if="{{taskTotal > 0}}"><text>{{taskTotal}}</text></view>
  </view>

  <!-- 空状态：无客户 -->
  <view class="task-empty" wx:if="{{taskEmptyType === 'no_customer'}}">
    <text class="task-empty-icon">📋</text>
    <text class="task-empty-title">还没有客户</text>
    <text class="task-empty-desc">添加客户后，ActPlan 会帮你识别今日要做和需关注客户</text>
    <van-button type="primary" size="small" bindtap="onGoAddCustomer">添加客户</van-button>
  </view>

  <!-- 空状态：无紧急任务 -->
  <view class="task-empty" wx:elif="{{taskEmptyType === 'no_urgent_task'}}">
    <text class="task-empty-icon">✅</text>
    <text class="task-empty-title">今天暂无紧急任务</text>
    <text class="task-empty-desc">当前没有需要立即处理的客户事项</text>
    <van-button type="default" size="small" bindtap="onGoNeedAttention">看看需关注</van-button>
  </view>

  <!-- 空状态：数据异常 -->
  <view class="task-empty" wx:elif="{{taskEmptyType === 'data_error'}}">
    <text class="task-empty-icon">⚠️</text>
    <text class="task-empty-title">数据加载失败</text>
    <text class="task-empty-desc">请稍后重试</text>
  </view>

  <!-- 任务列表 -->
  <view class="task-list" wx:elif="{{todayTasks.length > 0}}">
    <view wx:for="{{todayTasks}}" wx:key="task_id" class="task-card task-type-{{item.task_type}}">
      <view class="task-card-top">
        <text class="task-customer-name">{{item.customer_name}}</text>
        <text class="stage-tag stage-{{item.customer_stage_class}}">{{item.customer_stage}}</text>
      </view>
      <text class="task-title">{{item.task_title}}</text>
      <text class="task-reason">{{item.reason}}</text>
      <view class="task-actions">
        <view wx:for="{{item.actions}}" wx:key="*this" wx:for-item="action"
              class="task-btn task-btn-{{index}}"
              data-task-id="{{item.task_id}}"
              data-action="{{action}}"
              catchtap="onTaskAction">
          <text>{{action}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="page-bottom-pad"></view>

  <!-- 修改计划底部 sheet -->
  <view class="plan-sheet" wx:if="{{showPlanSheet}}">
    <view class="plan-sheet-mask" bindtap="onPlanSheetCancel"></view>
    <view class="plan-sheet-content card">
      <view class="plan-sheet-header">
        <text class="plan-sheet-title">{{planSheetMode === 'add' ? '添加拜访计划' : '修改拜访计划'}}</text>
        <text class="plan-sheet-close" bindtap="onPlanSheetCancel">×</text>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">客户</text>
        <text class="plan-sheet-value">{{planSheetCustomerName}}</text>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">日期</text>
        <picker mode="date" value="{{planSheetDate}}" bindchange="onPlanSheetDateChange">
          <text class="plan-sheet-value plan-sheet-picker">{{planSheetDate}} ▾</text>
        </picker>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">时间</text>
        <picker mode="time" value="{{planSheetTime}}" start="06:00" end="23:30" bindchange="onPlanSheetTimeChange">
          <text class="plan-sheet-value {{planSheetTime ? 'plan-sheet-picker' : 'plan-sheet-placeholder'}}">{{planSheetTime || '请选择'}} ▾</text>
        </picker>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">方式</text>
        <view class="plan-sheet-chips">
          <view wx:for="{{visitWayOptions}}" wx:key="*this"
            class="plan-sheet-chip {{planSheetVisitWay === item ? 'active' : ''}}"
            data-way="{{item}}" bindtap="onPlanSheetWayChange">{{item}}</view>
        </view>
      </view>
      <view class="plan-sheet-field">
        <view class="plan-sheet-goal-header">
          <text class="plan-sheet-label">拜访目标</text>
          <text class="plan-sheet-goal-count">{{planSheetGoal.length}}/20</text>
        </view>
        <textarea class="plan-sheet-goal-input"
          placeholder="请输入本次拜访目标（选填）..."
          placeholder-class="plan-sheet-placeholder"
          value="{{planSheetGoal}}"
          maxlength="20"
          bindinput="onPlanSheetGoalInput"
          auto-height/>
      </view>
      <view class="plan-sheet-actions">
        <view class="plan-sheet-btn plan-sheet-btn-cancel" bindtap="onPlanSheetCancel">
          <text class="plan-sheet-btn-text">取消</text>
        </view>
        <view class="plan-sheet-btn plan-sheet-btn-confirm {{isSaving ? 'disabled' : ''}}" bindtap="{{isSaving ? '' : 'onPlanSheetConfirm'}}">
          <text class="plan-sheet-btn-text">{{isSaving ? '保存中...' : (planSheetMode === 'add' ? '确认添加' : '确认修改')}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
