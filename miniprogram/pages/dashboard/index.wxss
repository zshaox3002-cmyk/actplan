/* pages/dashboard/index.wxss */

/* ---- 页面容器 ---- */
.page-container {
  padding: 16rpx 24rpx 0;
}

/* ---- 数据菜单按钮（右上角） ---- */
.data-menu-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  margin-left: auto;
  margin-bottom: 8rpx;
}

.data-menu-btn:active {
  background: #E8F1FC;
}

.data-menu-icon {
  font-size: 20px;
  color: #6B7280;
  font-weight: bold;
}

/* ---- 周期选择栏 ---- */
.period-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.period-selector {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #E8F1FC;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.period-label {
  font-size: 24rpx;
  color: #1A6FD4;
  font-weight: 600;
}

.period-arrow {
  width: 24rpx;
  height: 24rpx;
  transition: transform 0.2s ease;
}

.period-arrow.open {
  transform: rotate(180deg);
}

.period-range {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* ---- 周期下拉选项 ---- */
.period-dropdown {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.25);
}

.period-dropdown-inner {
  position: absolute;
  top: 180rpx;
  left: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  min-width: 240rpx;
  overflow: hidden;
}

.period-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #374151;
}

.period-option:active {
  background: #F3F4F6;
}

.period-option.active {
  color: #1A6FD4;
  font-weight: 600;
}

.period-check {
  font-size: 28rpx;
  color: #1A6FD4;
  font-weight: 700;
}

/* ---- 指标卡网格 ---- */
.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

/* ---- 图表区 ---- */
.chart-section {
  margin-bottom: 8rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
}

.title-bar {
  width: 6rpx;
  height: 32rpx;
  background: #1A6FD4;
  border-radius: 3rpx;
  flex-shrink: 0;
}

.section-title text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
}

/* ---- 数据操作面板 ---- */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.panel-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 24rpx;
  border-bottom: 1px solid #E5E7EB;
}

.panel-title {
  font-size: 18px;
  font-weight: 600;
  color: #1A1A2E;
}

.panel-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  color: #9CA3AF;
}

.panel-body {
  padding: 24rpx;
}

.panel-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  margin-bottom: 8px;
  border-radius: 16px;
  background: #F5F6FA;
}

.panel-item:active {
  background: #E8F1FC;
}

.panel-item-icon {
  font-size: 28px;
}

.panel-item-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.panel-item-title {
  font-size: 15px;
  font-weight: 500;
  color: #1A1A2E;
}

.panel-item-desc {
  font-size: 12px;
  color: #9CA3AF;
}

/* ---- 空态引导 ---- */
.dashboard-empty { display: flex; flex-direction: column; align-items: center; padding: 80rpx 48rpx 40rpx; }
.dashboard-empty .empty-icon-text { font-size: 120rpx; margin-bottom: 40rpx; }
.dashboard-empty .empty-title { font-size: 36rpx; font-weight: 700; color: #111827; margin-bottom: 16rpx; }
.dashboard-empty .empty-desc { font-size: 28rpx; color: #9CA3AF; text-align: center; line-height: 1.7; margin-bottom: 48rpx; }
.dashboard-empty .empty-actions { display: flex; flex-direction: column; align-items: center; gap: 20rpx; width: 100%; }
.dashboard-empty .empty-btn-primary { width: 100%; height: 96rpx; background: #1A6FD4; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; color: #fff; }
.dashboard-empty .empty-btn-secondary { height: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #6B7280; }
