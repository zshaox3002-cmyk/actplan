/* pages/dashboard/index.wxss */

/* ---- 页面容器 ---- */
.page-container {
  padding: 16rpx 24rpx 0;
}

/* ---- 问候语 Hero 区域 ---- */
.hero-bar {
  padding: 24rpx 0 16rpx;
}
.hero-greeting {
  font-size: 36rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  display: block;
}
.hero-subtext {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 6rpx;
}
.hero-subtext--warn {
  color: var(--color-warning);
}

/* ---- KPI 三格 ---- */
.kpi-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.kpi-card {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: var(--shadow-card);
}
.kpi-num {
  font-size: 48rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  line-height: 1;
}
.kpi-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.kpi-danger .kpi-num {
  color: var(--color-danger);
}
.kpi-success .kpi-num {
  color: var(--color-success);
}

/* ---- section 标题 ---- */
.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 48rpx;
  margin-bottom: 16rpx;
}
.section-title text {
  font-size: 32rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}
.section-badge {
  background: var(--color-primary-light);
  border-radius: var(--radius-badge);
  padding: 2rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.section-badge text {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
}

/* ---- 今日要做空状态 ---- */
.task-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  gap: 16rpx;
}
.task-empty-icon {
  font-size: 80rpx;
}
.task-empty-title {
  font-size: 30rpx;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}
.task-empty-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}

/* ---- 任务列表 ---- */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.task-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx 28rpx 20rpx;
  box-shadow: var(--shadow-card);
  border-left: 6rpx solid var(--color-border);
}
.task-card.task-type-overdue_plan {
  border-left-color: var(--color-danger);
}
.task-card.task-type-today_plan {
  border-left-color: var(--color-primary);
}
.task-card.task-type-stuck {
  border-left-color: var(--color-warning);
}
.task-card.task-type-break_risk {
  border-left-color: var(--color-text-secondary);
}
.task-card-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.task-customer-name {
  font-size: 30rpx;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}
.task-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 8rpx;
}
.task-reason {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 20rpx;
}
.task-actions {
  display: flex;
  gap: 16rpx;
}
.task-btn {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-page);
}
.task-btn:active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
}
.task-btn text {
  font-size: 24rpx;
  color: var(--color-text-primary);
}
.task-btn-0 {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.task-btn-0:active {
  opacity: 0.85;
}
.task-btn-0 text {
  color: #fff;
}

/* ---- 阶段标签（任务卡片内） ---- */
.stage-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-badge);
  background: transparent;
  border: 1rpx solid currentColor;
}
.stage-tag.stage-meet    { color: var(--stage-meet-text); }
.stage-tag.stage-comm    { color: var(--stage-comm-text); }
.stage-tag.stage-present { color: var(--stage-present-text); }
.stage-tag.stage-closing { color: var(--stage-closing-text); }
.stage-tag.stage-deal    { color: var(--stage-deal-text); }
.stage-tag.stage-lost    { color: var(--stage-lost-text); }

/* ---- 底部留白 ---- */
.page-bottom-pad {
  height: 120rpx;
}

/* ---- 修改计划底部 sheet ---- */
.plan-sheet {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.plan-sheet-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}
.plan-sheet-content {
  position: relative;
  width: 100%;
  padding: 20px var(--spacing-card);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  z-index: 1;
}
.plan-sheet-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 24rpx;
}
.plan-sheet-title {
  font-size: var(--font-size-module);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  display: block;
}
.plan-sheet-close {
  position: absolute;
  right: 0;
  font-size: 40rpx;
  color: var(--color-text-secondary);
  line-height: 1;
  padding: 0 4rpx;
}
.plan-sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.plan-sheet-label {
  font-size: var(--font-size-secondary);
  color: var(--color-text-secondary);
}
.plan-sheet-value {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}
.plan-sheet-picker { color: var(--color-primary); }
.plan-sheet-placeholder { color: var(--color-text-placeholder); }
.plan-sheet-field { margin-bottom: 16rpx; }
.plan-sheet-chips { display: flex; gap: 12rpx; }
.plan-sheet-chip {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-badge);
  border: 1rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.plan-sheet-chip.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}
.plan-sheet-goal-header { display: flex; justify-content: space-between; align-items: center; }
.plan-sheet-goal-count { font-size: 22rpx; color: var(--color-text-placeholder); }
.plan-sheet-goal-input {
  width: 100%;
  min-height: 80rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-input);
  font-size: 28rpx;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  box-sizing: border-box;
  line-height: 1.6;
}
.plan-sheet-actions {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}
.plan-sheet-btn {
  flex: 1;
  height: var(--height-button);
  border-radius: var(--radius-button);
  display: flex;
  align-items: center;
  justify-content: center;
}
.plan-sheet-btn-cancel {
  background-color: var(--color-bg-page);
  border: 1px solid var(--color-border);
}
.plan-sheet-btn-cancel .plan-sheet-btn-text { color: var(--color-text-secondary); }
.plan-sheet-btn-confirm { background-color: var(--color-primary); }
.plan-sheet-btn-confirm .plan-sheet-btn-text {
  color: var(--color-bg-card);
  font-weight: var(--font-weight-semibold);
}
.plan-sheet-btn-text { font-size: var(--font-size-body); }
