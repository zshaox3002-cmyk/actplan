<view class="page-container" bindtap="onPageTap">
  <!-- 搜索栏 -->
  <search-bar
    value="{{keyword}}"
    placeholder="搜索客户姓名"
    bind:input="onSearchInput"
    bind:clear="onSearchClear"
  ></search-bar>

  <!-- 筛选栏 -->
  <filter-bar
    apple-rank="{{appleRank}}"
    stage="{{stage}}"
    bind:change="onFilterChange"
  ></filter-bar>

  <!-- 加载态 -->
  <skeleton wx:if="{{pageState === 'loading'}}" rows="{{5}}" />

  <!-- 数据列表 -->
  <view class="customer-list" wx:elif="{{pageState === 'data'}}">
    <customer-card
      wx:for="{{customers}}"
      wx:key="id"
      customer="{{item}}"
      bind:tap="onCustomerTap"
      bind:delete="onCustomerDelete"
    ></customer-card>
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{pageState === 'empty'}}"
    icon="👤"
    text="还没有客户"
    subText="点击右下角 + 号添加第一位客户 ↘"
  />

  <!-- 错误状态 -->
  <empty-state
    wx:elif="{{pageState === 'error'}}"
    icon="⚠️"
    text="加载失败"
    subText="请稍后重试"
  />

  <!-- FAB 新建按钮 -->
  <fab-button bindtap="onAddCustomer" />
</view>
