<!-- pages/customer/index.wxml -->
<view class="page-container" bindtap="onPageTap">

  <!-- 搜索栏 -->
  <view class="search-row">
    <search-bar
      value="{{keyword}}"
      placeholder="搜索客户姓名 / 标签 / 备注"
      bind:input="onSearchInput"
      bind:clear="onSearchClear"
    />
    <view class="data-manage-btn" bindtap="onDataManage">
      <text class="data-manage-icon">⇅</text>
    </view>
  </view>

  <!-- 视图切换器（v1.1，替换原优先级/阶段 Chip） -->
  <scroll-view scroll-x class="chip-scroll">
    <view class="chip-list">
      <!-- 全部（硬编码，无规则） -->
      <view class="chip-item {{activeSegmentId === null ? 'active' : ''}}"
            data-id=""
            bindtap="onSegmentTap">
        <text>全部</text>
      </view>
      <!-- 系统预设 + 自建视图 -->
      <view wx:for="{{segments}}"
            wx:key="id"
            class="chip-item chip-segment {{activeSegmentId === item.id ? 'active' : ''}} {{item.color ? 'chip-color-' + item.color : ''}}"
            data-id="{{item.id}}"
            data-is-system="{{item.is_system}}"
            bindtap="onSegmentTap"
            bindlongpress="onSegmentLongPress">
        <text>{{item.name}}</text>
        <text class="chip-count" wx:if="{{segmentCounts[item.id] > 0}}"> {{segmentCounts[item.id]}}</text>
      </view>
      <!-- 新建按钮 -->
      <view class="chip-item chip-add {{addSegmentDisabled ? 'disabled' : ''}}"
            bindtap="onAddSegment">
        <text>+ 新建</text>
      </view>
    </view>
  </scroll-view>

  <!-- 视图编辑提示 -->
  <text class="chip-hint" wx:if="{{segments.length > 0}}">长按视图可编辑规则</text>

  <!-- 介绍人未填写提示 -->
  <view wx:if="{{missingReferrerCustomers.length > 0}}" class="referrer-tip-card">
    <view class="referrer-tip-header">
      <view class="referrer-tip-title">数据待完善</view>
      <view class="referrer-tip-count">{{missingReferrerCustomers.length}} 位客户</view>
    </view>
    <view class="referrer-tip-desc">以下客户关系来源为「客户介绍」，但尚未填写介绍人：</view>
    <view class="referrer-tip-list">
      <text
        wx:for="{{missingReferrerCustomers}}"
        wx:key="id"
        class="referrer-tip-item"
        data-id="{{item.id}}"
        bindtap="onMissingReferrerTap"
      >· {{item.name}}</text>
    </view>
    <view class="referrer-tip-hint">点击客户名可前往详情页补填介绍人信息</view>
  </view>

  <!-- 加载态 -->
  <skeleton wx:if="{{pageState === 'loading'}}" rows="{{5}}" />

  <!-- 数据列表 -->
  <view class="customer-list" wx:elif="{{pageState === 'data'}}">
    <customer-card
      wx:for="{{customers}}"
      wx:key="id"
      customer="{{item}}"
      view-context="{{activeViewContext}}"
      bind:tap="onCustomerTap"
      bind:delete="onCustomerDelete"
      bind:addPlan="onAddPlan"
      bind:addRecord="onAddRecord"
    />
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{pageState === 'empty'}}"
    icon="👤"
    text="暂无客户"
    subText="点击右下角 + 添加第一位客户"
  />

  <!-- FAB -->
  <fab-button bindtap="onAddCustomer" />

  <!-- 添加计划底部 sheet -->
  <view class="plan-sheet" wx:if="{{showPlanSheet}}">
    <view class="plan-sheet-mask" bindtap="onPlanSheetCancel"></view>
    <view class="plan-sheet-content card">
      <view class="plan-sheet-header">
        <text class="plan-sheet-title">添加拜访计划</text>
        <text class="plan-sheet-close" bindtap="onPlanSheetCancel">×</text>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">客户</text>
        <text class="plan-sheet-value">{{planSheetCustomerName}}</text>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">日期</text>
        <picker mode="date" value="{{planSheetDate}}" bindchange="onPlanSheetDateChange">
          <text class="plan-sheet-value plan-sheet-picker">{{planSheetDate}} ▾</text>
        </picker>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">时间</text>
        <picker mode="time" value="{{planSheetTime}}" start="06:00" end="23:30" bindchange="onPlanSheetTimeChange">
          <text class="plan-sheet-value {{planSheetTime ? 'plan-sheet-picker' : 'plan-sheet-placeholder'}}">{{planSheetTime || '请选择'}} ▾</text>
        </picker>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">方式</text>
        <view class="plan-sheet-chips">
          <view wx:for="{{visitWayOptions}}" wx:key="*this"
            class="plan-sheet-chip {{planSheetVisitWay === item ? 'active' : ''}}"
            data-way="{{item}}" bindtap="onPlanSheetWayChange">{{item}}</view>
        </view>
      </view>
      <view class="plan-sheet-field">
        <view class="plan-sheet-goal-header">
          <text class="plan-sheet-label">拜访目标</text>
          <text class="plan-sheet-goal-count">{{planSheetGoal.length}}/20</text>
        </view>
        <textarea class="plan-sheet-goal-input"
          placeholder="请输入本次拜访目标（选填）..."
          placeholder-class="plan-sheet-placeholder"
          value="{{planSheetGoal}}"
          maxlength="20"
          bindinput="onPlanSheetGoalInput"
          auto-height/>
      </view>
      <view class="plan-sheet-actions">
        <view class="plan-sheet-btn plan-sheet-btn-cancel" bindtap="onPlanSheetCancel">
          <text class="plan-sheet-btn-text">取消</text>
        </view>
        <view class="plan-sheet-btn plan-sheet-btn-confirm {{isSaving ? 'disabled' : ''}}" bindtap="{{isSaving ? '' : 'onPlanSheetConfirm'}}">
          <text class="plan-sheet-btn-text">{{isSaving ? '保存中...' : '确认添加'}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
