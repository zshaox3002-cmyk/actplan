/* customer/index.wxss — 客户列表页 */
page {
  background: #F5F6FA;
}

.page-container {
  padding: 16rpx 24rpx 120rpx;
}

.customer-list {
  /* 列表容器 — 卡片间距由 card 自身 margin-bottom 控制 */
}

/* FAB 浮动按钮 */
.fab {
  position: fixed;
  right: 24rpx;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 24rpx);
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: #1A6FD4;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(26, 111, 212, 0.35);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.fab:active {
  background-color: #1557b0;
}
