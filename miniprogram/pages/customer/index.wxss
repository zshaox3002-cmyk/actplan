/* customer/index.wxss */
page { background: var(--color-bg-page); }

.page-container {
  padding: 16rpx 24rpx 192rpx;
}

/* 优先级 Chip 筛选 */
.chip-scroll {
  white-space: nowrap;
  margin: 0 -24rpx;
  padding: 0 24rpx;
}
.chip-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 16rpx 24rpx 16rpx 0;
}
.chip-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: var(--chip-inactive-bg);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--chip-inactive-text);
  white-space: nowrap;
}
.chip-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary-dark);
  font-weight: 500;
}

/* 视图颜色标记（未激活态：浅色背景 + 深色文字；激活态：深色背景） */
.chip-color-gold   { background: var(--color-warning-light);   color: var(--color-warning); }
.chip-color-purple { background: var(--color-purple-light);    color: var(--color-purple); }
.chip-color-blue   { background: var(--color-secondary-light); color: var(--color-secondary); }
.chip-color-green  { background: var(--color-success-light);   color: var(--color-success); }
.chip-color-gray   { background: var(--color-bg-page);         color: var(--color-text-secondary); }

.chip-color-gold.active   { background: var(--color-warning);   color: #fff; }
.chip-color-purple.active { background: var(--color-purple);    color: #fff; }
.chip-color-blue.active   { background: var(--color-secondary); color: #fff; }
.chip-color-green.active  { background: var(--color-success);   color: #fff; }
.chip-color-gray.active   { background: var(--color-neutral);   color: #fff; }

.chip-divider {
  width: 2rpx;
  height: 28rpx;
  background: var(--color-border);
  align-self: center;
  flex-shrink: 0;
}

.chip-hint {
  display: block;
  font-size: var(--font-size-helper);
  color: var(--color-text-placeholder);
  padding: 0 0 8rpx;
}

.referrer-tip-card {
  background: var(--color-warning-light);
  border-radius: var(--radius-badge);
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.referrer-tip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.referrer-tip-title {
  font-size: var(--font-size-label);
  font-weight: var(--font-weight-medium);
  color: var(--color-warning);
}

.referrer-tip-count {
  font-size: var(--font-size-caption);
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
}

.referrer-tip-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.referrer-tip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.referrer-tip-item {
  font-size: var(--font-size-caption);
  color: var(--color-warning);
  text-decoration: underline;
}

.referrer-tip-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}

.customer-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ---- 添加计划底部 sheet ---- */
.plan-sheet {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.plan-sheet-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}
.plan-sheet-content {
  position: relative;
  width: 100%;
  padding: 20px var(--spacing-card);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  z-index: 1;
}
.plan-sheet-title {
  font-size: var(--font-size-module);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 16px;
  display: block;
}
.plan-sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.plan-sheet-label {
  font-size: var(--font-size-secondary);
  color: var(--color-text-secondary);
}
.plan-sheet-value {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}
.plan-sheet-picker {
  color: var(--color-primary);
}
.plan-sheet-placeholder {
  color: var(--color-text-placeholder);
}
.plan-sheet-time-row {
  display: flex;
  align-items: center;
}
.plan-sheet-datetime-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.plan-sheet-time-clear {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: var(--font-size-helper);
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  border-radius: var(--radius-badge);
}
.plan-sheet-time-clear:active { background: var(--color-border); }
.plan-sheet-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 24rpx;
}
.plan-sheet-close {
  position: absolute;
  right: 0;
  font-size: 40rpx;
  color: var(--color-text-secondary);
  line-height: 1;
  padding: 0 4rpx;
}
.plan-sheet-field { margin-bottom: 16rpx; }
.plan-sheet-chips { display: flex; gap: 12rpx; }
.plan-sheet-chip {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-badge);
  border: 1rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.plan-sheet-chip.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}
.plan-sheet-goal-header { display: flex; justify-content: space-between; align-items: center; }
.plan-sheet-goal-count { font-size: 22rpx; color: var(--color-text-placeholder); }
.plan-sheet-goal-input {
  width: 100%;
  min-height: 80rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-input);
  font-size: 28rpx;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  box-sizing: border-box;
  line-height: 1.6;
}
.plan-sheet-actions {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}
.plan-sheet-btn {
  flex: 1;
  height: var(--height-button);
  border-radius: var(--radius-button);
  display: flex;
  align-items: center;
  justify-content: center;
}
.plan-sheet-btn-cancel {
  background-color: var(--color-bg-page);
  border: 1px solid var(--color-border);
}
.plan-sheet-btn-cancel .plan-sheet-btn-text { color: var(--color-text-secondary); }
.plan-sheet-btn-confirm { background-color: var(--color-primary); }
.plan-sheet-btn-confirm .plan-sheet-btn-text {
  color: var(--color-bg-card);
  font-weight: var(--font-weight-semibold);
}
.plan-sheet-btn-text { font-size: var(--font-size-body); }

/* 搜索栏 + 数据管理入口行 */
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search-row search-bar {
  flex: 1;
}
.data-manage-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-xs);
}
.data-manage-icon {
  font-size: 36rpx;
  color: var(--color-primary);
}
