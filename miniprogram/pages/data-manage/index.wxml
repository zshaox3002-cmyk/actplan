<view class="container">

  <view class="section-card">
    <view class="section-header">
      <view class="section-title">客户画像信息</view>
      <button class="template-btn" bindtap="downloadCustomerTemplate">下载模版</button>
    </view>
    <view class="action-row">
      <button class="action-btn" bindtap="importCustomers" loading="{{importing}}">导入</button>
      <button class="action-btn outline" bindtap="exportCustomers" loading="{{exporting}}">导出</button>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">
      <view class="section-title">保单信息</view>
      <button class="template-btn" bindtap="downloadPolicyTemplate">下载模版</button>
    </view>
    <view class="action-row">
      <button class="action-btn" bindtap="importPolicies" loading="{{importing}}">导入</button>
      <button class="action-btn outline" bindtap="exportPolicies" loading="{{exporting}}">导出</button>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">
      <view class="section-title">拜访记录</view>
      <button class="template-btn" bindtap="downloadRecordTemplate">下载模版</button>
    </view>
    <view class="action-row">
      <button class="action-btn" bindtap="importRecords" loading="{{importing}}">导入</button>
      <button class="action-btn outline" bindtap="exportRecords" loading="{{exporting}}">导出</button>
    </view>
  </view>

</view>
