.container {
  padding: var(--spacing-page);
  background: var(--color-bg-page);
  min-height: 100vh;
}

.section-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: var(--height-button);
  line-height: var(--height-button);
  font-size: var(--font-size-body);
  border-radius: var(--radius-button);
  padding: 0;
  border: none;
}

.action-btn.primary {
  background: var(--color-primary);
  color: #fff;
}

.action-btn.secondary {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.action-btn.outline {
  background: var(--color-bg-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.action-btn[disabled] {
  opacity: 0.4;
}

.preview-panel {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.preview-title {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.stat-item {
  flex: 1;
  min-width: 100rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-badge);
  padding: 16rpx 8rpx;
  text-align: center;
}

.stat-value {
  font-size: var(--font-size-data-card);
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
}

.stat-item.create .stat-value { color: var(--color-success); }
.stat-item.update .stat-value { color: var(--color-primary); }
.stat-item.skip .stat-value { color: var(--color-text-secondary); }
.stat-item.error .stat-value { color: var(--color-danger); }

.stat-label {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.issue-section {
  margin-bottom: 20rpx;
  border-radius: var(--radius-badge);
  padding: 16rpx;
}

.error-section {
  background: var(--color-danger-light);
}

.warning-section {
  background: var(--color-warning-light);
}

.issue-title {
  font-size: var(--font-size-label);
  font-weight: var(--font-weight-medium);
  margin-bottom: 10rpx;
}

.error-section .issue-title { color: var(--color-danger); }
.warning-section .issue-title { color: var(--color-warning); }

.issue-item {
  font-size: var(--font-size-caption);
  line-height: 1.6;
  padding: 4rpx 0;
}

.error-item { color: var(--color-danger); }
.warning-item { color: var(--color-warning); }

.issue-more {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.preview-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.referrer-tip-card {
  margin-bottom: 20rpx;
}

.referrer-tip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.referrer-tip-count {
  font-size: var(--font-size-caption);
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
}

.referrer-tip-desc {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.referrer-tip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.referrer-tip-item {
  font-size: var(--font-size-caption);
  color: var(--color-warning);
  text-decoration: underline;
}

.referrer-tip-hint {
  font-size: var(--font-size-caption);
  color: var(--color-text-secondary);
}
