.container {
  padding: 24rpx 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.section-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.template-btn {
  font-size: 24rpx;
  color: #4a90e2;
  background: #eaf2fd;
  border: none;
  border-radius: 6rpx;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 30rpx;
  border-radius: 8rpx;
  background: #4a90e2;
  color: #fff;
  border: none;
  padding: 0;
}

.action-btn.outline {
  background: #fff;
  color: #4a90e2;
  border: 2rpx solid #4a90e2;
}

.action-btn[loading] {
  opacity: 0.6;
}
