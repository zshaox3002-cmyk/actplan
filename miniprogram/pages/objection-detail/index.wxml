<!-- pages/objection-detail/index.wxml -->
<view class="page-container">
  <block wx:if="{{objection}}">
    <!-- 顶部信息 -->
    <view class="detail-header">
      <view class="header-top">
        <view class="category-badge badge-{{categoryClass}}">
          <text class="badge-text">{{objection.category}}</text>
        </view>
        <text class="count-text">出现 {{objection.occurrenceCount || objection.count || 0}} 次</text>
      </view>
      <text class="created-text" wx:if="{{objection.created_at}}">创建于 {{objection.created_at}}</text>
      <text class="created-text" wx:elif="{{objection.isPreset}}">官方推荐话术</text>
    </view>

    <!-- 异议内容 -->
    <view class="detail-section">
      <view class="section-title">异议内容</view>
      <view class="section-body">
        <text class="body-text">{{objection.content}}</text>
      </view>
    </view>

    <!-- 应对话术：预置异议展示四步结构 -->
    <view class="detail-section" wx:if="{{objection.script}}">
      <view class="section-title">应对话术</view>
      <view class="script-section">
        <text class="script-step-title">① 认同</text>
        <text class="script-step-content">{{objection.script.step1_affirm}}</text>

        <text class="script-step-title">② 澄清</text>
        <text class="script-step-content">{{objection.script.step2_clarify}}</text>

        <text class="script-step-title">③ 回应</text>
        <text class="script-step-content">{{objection.script.step3_response}}</text>

        <text class="script-step-title">④ 确认</text>
        <text class="script-step-content">{{objection.script.step4_confirm}}</text>
      </view>
    </view>

    <!-- 应对话术：用户自建异议展示原始文本 -->
    <view class="detail-section" wx:elif="{{objection.solution}}">
      <view class="section-title">应对话术</view>
      <view class="section-body solution-body">
        <text class="body-text">{{objection.solution}}</text>
      </view>
    </view>

    <!-- 追加历史 -->
    <view class="detail-section">
      <view class="section-title">追加历史</view>

      <view class="note-list" wx:if="{{notes.length > 0}}">
        <view class="note-item" wx:for="{{notes}}" wx:key="id">
          <view class="note-header">
            <text class="note-customer">{{customerMap[item.customer_id] || '未知客户'}}</text>
            <text class="note-time">{{item.created_at}}</text>
          </view>
          <text class="note-content">{{item.note}}</text>
        </view>
      </view>

      <view class="empty-notes" wx:else>
        <text class="empty-text">暂无追加备注</text>
      </view>
    </view>
  </block>
</view>
