/* pages/objection-detail/index.wxss */

/* ---- 顶部信息 ---- */
.detail-header {
  padding: var(--spacing-card);
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--spacing-section);
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4px;
}

.category-badge {
  padding: var(--spacing-badge-py) var(--spacing-badge-px);
  border-radius: var(--radius-badge);
  font-size: var(--font-size-helper);
  line-height: var(--line-height-helper);
}

.badge-text {
  color: inherit;
}

/* 分类颜色映射 */
/* WXSS 不支持中文类名，统一用英文 .badge-{英文名} */
.badge-price {
  background: var(--priority-p0-bg);
  color: var(--color-danger);
}

.badge-necessity {
  background: var(--priority-p1-bg);
  color: var(--color-warning);
}

.badge-timing {
  background: var(--stage-present-bg);
  color: var(--color-secondary);
}

.badge-compare {
  background: var(--stage-present-bg);
  color: var(--color-secondary);
}

.badge-trust {
  background: var(--stage-deal-bg);
  color: var(--color-success);
}

.badge-other {
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.count-text {
  font-size: var(--font-size-secondary);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
}

.created-text {
  font-size: var(--font-size-helper);
  color: var(--color-text-placeholder);
}

/* ---- 内容区 ---- */
.detail-section {
  margin-bottom: var(--spacing-section);
}

.section-title {
  font-size: var(--font-size-module);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-card-gap);
}

.section-body {
  padding: var(--spacing-card);
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
}

.body-text {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  white-space: pre-wrap;
}

.solution-body {
  background: var(--color-primary-light);
  border-left: 4px solid var(--color-primary);
}

/* ---- 四步话术结构 ---- */
.script-section { padding: 24rpx; }
.script-step-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin: 28rpx 0 8rpx;
  letter-spacing: 1rpx;
}
.script-step-title:first-child {
  margin-top: 0;
}
.script-step-content {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.8;
  white-space: pre-wrap;
  padding-left: 16rpx;
  border-left: 3rpx solid var(--stage-present-bg);
}

/* ---- 化解率 ---- */
.resolution-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.resolution-label {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}
.resolution-bar-wrap {
  width: 160rpx;
  height: 12rpx;
  background: var(--color-bg-page);
  border-radius: 6rpx;
  overflow: hidden;
}
.resolution-bar {
  height: 100%;
  background: var(--color-success);
  border-radius: 6rpx;
  min-width: 4rpx;
}
.resolution-pct {
  font-size: 24rpx;
  color: var(--color-success);
  font-weight: 500;
}
.resolution-insufficient {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

/* ---- 官方推荐徽章 ---- */
.preset-badge {
  padding: var(--spacing-badge-py) var(--spacing-badge-px);
  background: var(--color-primary-light);
  border-radius: var(--radius-badge);
}
.preset-badge text {
  font-size: var(--font-size-helper);
  color: var(--color-primary-dark);
}

/* ---- 实战记录结果标签 ---- */
.note-result {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-badge);
}
.note-result text { font-size: 22rpx; font-weight: 500; }
.result-resolved { background: var(--stage-deal-bg); }
.result-resolved text { color: var(--stage-deal-text); }
.result-pending { background: var(--priority-p1-bg); }
.result-pending text { color: var(--priority-p1-text); }
.result-failed { background: var(--priority-p0-bg); }
.result-failed text { color: var(--color-danger); }
.result-none { display: none; }

/* ---- 追加历史 ---- */
.note-list {
  /* 列表容器 */
}

.note-item {
  padding: var(--spacing-card);
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--spacing-card-gap);
}

.note-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.note-customer {
  font-size: var(--font-size-secondary);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.note-time {
  font-size: var(--font-size-helper);
  color: var(--color-text-placeholder);
}

.note-content {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  line-height: var(--line-height-body);
  white-space: pre-wrap;
}

.empty-notes {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 0;
}

.empty-text {
  font-size: var(--font-size-secondary);
  color: var(--color-text-placeholder);
}
