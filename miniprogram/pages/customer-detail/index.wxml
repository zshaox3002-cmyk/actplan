<!-- pages/customer-detail/index.wxml -->
<view class="page-wrap">

  <!-- 加载态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:else>

    <!-- 顶部客户卡片 -->
    <view class="top-card">
      <view class="top-card-header">
        <text class="customer-name">{{customerName}}</text>
        <view class="priority-tag priority-{{priorityLevel}}" wx:if="{{priorityLevel}}">
          <text>{{priorityLevel}} {{priorityLabel}}</text>
        </view>
      </view>

      <!-- 阶段标签 + 自定义标签同行 -->
      <view class="top-labels" wx:if="{{stageLabel || tags.length > 0}}">
        <view class="stage-tag stage-{{stageClassMap[stageLabel]}}" wx:if="{{stageLabel}}">
          <text>{{stageLabel}}</text>
        </view>
        <view class="custom-tag" wx:for="{{tags}}" wx:key="*this">
          <text>{{item}}</text>
        </view>
      </view>

      <!-- 沟通信息 -->
      <view class="contact-info">
        <text class="contact-item">最近沟通：{{lastVisit || '暂无'}}</text>
        <text class="contact-item next-plan {{nextPlanText === '未安排' ? 'no-plan' : ''}}">
          下次跟进：{{nextPlanText}}
        </text>
      </view>

      <!-- 快捷操作 -->
      <view class="quick-actions">
        <view class="quick-btn quick-btn-primary {{isNew ? 'disabled' : ''}}"
              bindtap="{{isNew ? '' : 'onAddPlan'}}">
          <text>预约</text>
        </view>
        <view class="quick-btn quick-btn-secondary {{isNew ? 'disabled' : ''}}"
              bindtap="{{isNew ? '' : 'onAddRecord'}}">
          <text>随手记</text>
        </view>
      </view>
    </view>

    <!-- Tab 导航 -->
    <view class="tab-nav">
      <view class="tab-item {{activeTab === 'profile' ? 'active' : ''}}"
            data-tab="profile" bindtap="onTabTap">
        <text>画像</text>
      </view>
      <view class="tab-item {{activeTab === 'policy' ? 'active' : ''}}"
            data-tab="policy" bindtap="onTabTap">
        <text>保单</text>
      </view>
      <view class="tab-item {{activeTab === 'timeline' ? 'active' : ''}}"
            data-tab="timeline" bindtap="onTabTap">
        <text>沟通</text>
      </view>
      <view class="tab-item {{activeTab === 'objection' ? 'active' : ''}}"
            data-tab="objection" bindtap="onTabTap">
        <text>异议</text>
      </view>
      <view class="tab-item {{activeTab === 'plan' ? 'active' : ''}}"
            data-tab="plan" bindtap="onTabTap">
        <text>计划</text>
      </view>
    </view>

    <!-- ===== 画像 Tab ===== -->
    <view wx:if="{{activeTab === 'profile'}}">
      <view class="section-card">
        <view class="section-header">
          <text class="section-title">客户画像</text>
          <view class="edit-btn" bindtap="onEditProfileTap" wx:if="{{!isEditProfile && !isNew}}">
            <text>编辑</text>
          </view>
        </view>

        <!-- 姓名 -->
        <view class="field-row" wx:if="{{isEditProfile}}">
          <text class="field-label">姓名<text class="required-mark">*</text></text>
          <input class="field-input"
                 value="{{form.name}}" placeholder="请输入姓名"
                 data-field="name" bindinput="onFieldChange"/>
        </view>

        <!-- 非编辑态：2列网格 -->
        <view wx:if="{{!isEditProfile}}">
          <view class="profile-grid">
            <view class="grid-cell">
              <text class="grid-label">性别</text>
              <text class="grid-value {{!profileGender ? 'grid-empty' : ''}}">{{profileGender || '未填写'}}</text>
            </view>
            <view class="grid-cell">
              <text class="grid-label">年龄</text>
              <text class="grid-value {{!profileAgeRange ? 'grid-empty' : ''}}">{{profileAgeRange || '未填写'}}</text>
            </view>
            <view class="grid-cell">
              <text class="grid-label">职业</text>
              <text class="grid-value {{!profileOccupation ? 'grid-empty' : ''}}">{{profileOccupation || '未填写'}}</text>
            </view>
            <view class="grid-cell">
              <text class="grid-label">收入</text>
              <text class="grid-value {{!profileIncome ? 'grid-empty' : ''}}">{{profileIncome || '未填写'}}</text>
            </view>
            <view class="grid-cell">
              <text class="grid-label">婚姻</text>
              <text class="grid-value {{!profileMarital ? 'grid-empty' : ''}}">{{profileMarital || '未填写'}}</text>
            </view>
            <view class="grid-cell">
              <text class="grid-label">家庭</text>
              <text class="grid-value {{!profileFamily ? 'grid-empty' : ''}}">{{profileFamily || '未填写'}}</text>
            </view>
            <view class="grid-cell">
              <text class="grid-label">交情</text>
              <text class="grid-value {{!profileIntimacy ? 'grid-empty' : ''}}">{{profileIntimacy || '未填写'}}</text>
            </view>
            <view class="grid-cell">
              <text class="grid-label">来源</text>
              <text class="grid-value {{!profileRelation ? 'grid-empty' : ''}}">{{profileRelation || '未填写'}}</text>
            </view>
          </view>
        </view>

        <!-- 编辑态：列表式字段 -->
        <block wx:if="{{isEditProfile}}">
          <inline-picker label="性别 *" options="{{genderOptions}}"
            value="{{genderIndex}}" disabled="{{false}}"
            bindchange="onGenderChange"/>
          <inline-picker label="年龄范围" options="{{ageRangeOptions}}"
            value="{{ageRangeIndex}}" disabled="{{false}}"
            bindchange="onAgeRangeChange"/>
          <inline-picker label="职业" options="{{occupationOptions}}"
            value="{{occupationIndex}}" disabled="{{false}}"
            bindchange="onOccupationChange"/>
          <inline-picker label="收入" options="{{incomeOptions}}"
            value="{{incomeIndex}}" disabled="{{false}}"
            bindchange="onIncomeChange"/>
          <inline-picker label="婚姻" options="{{maritalOptions}}"
            value="{{maritalIndex}}" disabled="{{false}}"
            bindchange="onMaritalChange"/>
          <inline-picker label="家庭" options="{{familyOptions}}"
            value="{{familyIndex}}" disabled="{{false}}"
            bindchange="onFamilyChange"/>
          <inline-picker label="居住" options="{{residenceOptions}}"
            value="{{residenceIndex}}" disabled="{{false}}"
            bindchange="onResidenceChange"/>
          <inline-picker label="交情" options="{{intimacyOptions}}"
            value="{{intimacyIndex}}" disabled="{{false}}"
            bindchange="onIntimacyChange"/>
          <inline-picker label="关系来源" options="{{relationOptions}}"
            value="{{relationIndex}}" disabled="{{false}}"
            bindchange="onRelationChange"/>
          <!-- 来源为"客户介绍"时展示介绍人选择 -->
          <view class="field-row" wx:if="{{isEditProfile && relationIndex === 5}}" bindtap="onSelectReferralTap">
            <text class="field-label">介绍人</text>
            <view class="field-value">
              <text style="color: {{referralSourceCustomerName ? 'var(--color-text-primary)' : 'var(--color-text-tertiary)'}}">{{referralSourceCustomerName || '请选择'}}</text>
              <text wx:if="{{referralSourceCustomerName}}" class="referral-clear" catchtap="onClearReferralSource">×</text>
            </view>
          </view>
          <inline-picker label="跟进阶段" options="{{stageOptions}}"
            value="{{stageIndex}}" disabled="{{false}}"
            bindchange="onStageChange"/>
          <inline-picker label="有需求" options="{{hasNeedOptions}}"
            value="{{hasNeedIndex}}" disabled="{{false}}"
            bindchange="onHasNeedChange"/>
          <inline-picker label="有能力" options="{{hasAbilityOptions}}"
            value="{{hasAbilityIndex}}" disabled="{{false}}"
            bindchange="onHasAbilityChange"/>
          <inline-picker label="是决策者" options="{{isDeciderOptions}}"
            value="{{isDeciderIndex}}" disabled="{{false}}"
            bindchange="onIsDeciderChange"/>
        </block>

        <!-- 客户标签：非编辑态常显，编辑态可编辑 -->
        <view class="field-row field-row-full field-row-tags" wx:if="{{!isEditProfile}}">
          <text class="field-label">客户标签</text>
          <view wx:if="{{tags.length > 0}}" class="tag-list tag-list-readonly">
            <view class="tag-item" wx:for="{{tags}}" wx:key="*this">
              <text>{{item}}</text>
            </view>
          </view>
          <text wx:else class="field-value-full tag-empty">暂无标签</text>
        </view>
        <view class="field-row field-row-full" wx:if="{{isEditProfile}}">
          <text class="field-label">客户标签</text>
          <view class="tag-editor">
            <!-- 预设标签快选 -->
            <view class="tag-preset-list">
              <view class="tag-preset-item {{presetTagActive[item] ? 'active' : ''}}"
                    wx:for="{{presetTags}}" wx:key="*this"
                    data-tag="{{item}}" bindtap="onPresetTagTap">
                <text>{{item}}</text>
              </view>
            </view>
            <view class="tag-list">
              <view class="tag-item" wx:for="{{tags}}" wx:key="*this">
                <text>{{item}}</text>
                <text class="tag-del" data-idx="{{index}}" bindtap="onTagDelete">×</text>
              </view>
            </view>
            <input class="tag-input" value="{{tagInput}}"
                   placeholder="输入标签回车添加"
                   bindinput="onTagInput"
                   bindconfirm="onTagConfirm"/>
          </view>
        </view>
        <!-- 转介绍来源：有来源时展示 -->
        <view class="field-row referral-source-row" wx:if="{{!isEditProfile && !isNew && referralSourceCustomerName}}">
          <text class="field-label">转介绍来源</text>
          <text class="field-value referral-link" bindtap="onJumpToReferralSource">{{referralSourceCustomerName}}</text>
        </view>
        <!-- 转介绍网络入口 -->
        <view class="field-row referral-network-row" wx:if="{{!isEditProfile && !isNew && referralCount > 0}}">
          <text class="field-label">转介绍网络</text>
          <text class="field-value referral-link" bindtap="onViewReferralNetwork">查看 {{referralCount}} 人 →</text>
        </view>
      </view>

      <!-- 保存按钮 -->
      <view class="save-bar" wx:if="{{isEditProfile}}">
        <button class="save-btn" disabled="{{isSaving}}" bindtap="onSaveProfile">{{isSaving ? '保存中...' : '保存'}}</button>
      </view>

      <!-- 介绍人选择弹窗 -->
      <view class="modal-mask" wx:if="{{showReferralPicker}}" bindtap="onReferralPickerClose">
        <view class="modal-sheet" catchtap="">
          <view class="modal-header">
            <text class="modal-title">选择介绍人</text>
            <text class="modal-close" bindtap="onReferralPickerClose">×</text>
          </view>
          <scroll-view class="modal-list" scroll-y>
            <view wx:if="{{referralCandidateList.length === 0}}" class="modal-empty">
              <text>暂无其他客户</text>
            </view>
            <view class="modal-item" wx:for="{{referralCandidateList}}" wx:key="id"
                  data-index="{{index}}" bindtap="onReferralCustomerSelect">
              <text class="modal-item-name">{{item.name}}</text>
              <text class="modal-item-stage stage-tag stage-{{stageClassMap[item.stage]}}">{{item.stage}}</text>
            </view>
          </scroll-view>
        </view>
      </view>

    </view>

    <!-- ===== 保单 Tab ===== -->
    <view wx:if="{{activeTab === 'policy'}}">

      <!-- 保单价值组 -->
      <view class="section-card" wx:if="{{!isNew && derived.policy_count > 0}}">
        <view class="section-header">
          <text class="section-title">保单价值</text>
        </view>
        <view class="profile-grid policy-value-grid">
          <view class="grid-cell">
            <text class="grid-label">保单数</text>
            <view class="pv-num-row">
              <text class="pv-num">{{derived.policy_count}}</text>
              <text class="pv-unit">份</text>
            </view>
          </view>
          <view class="grid-cell">
            <text class="grid-label">年缴总保费</text>
            <view class="pv-num-row">
              <text class="pv-num">{{derived.total_premium_display}}</text>
              <text class="pv-unit">{{derived.total_premium_unit}}</text>
            </view>
          </view>
          <view class="grid-cell">
            <text class="grid-label">本年待缴</text>
            <view class="pv-num-row">
              <text class="pv-num">{{derived.yearly_pending_display}}</text>
              <text class="pv-unit">{{derived.yearly_pending_unit}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 保单区块 -->
      <view class="section-card" wx:if="{{!isNew}}">
        <view class="section-header">
          <text class="section-title">保单</text>
          <view class="edit-btn" bindtap="onAddPolicy">
            <text>+ 添加</text>
          </view>
        </view>

        <view wx:if="{{showHistoryBackfillTip}}" class="backfill-tip">
          <text>检测到 {{historyDealCount}} 条历史成交记录未录入保单，可手动添加</text>
        </view>

        <view wx:if="{{policies.length === 0}}" class="empty-hint">
          <text>暂无保单记录</text>
        </view>

        <view class="policy-list" wx:else>
          <view class="policy-item" wx:for="{{policies}}" wx:key="id">
            <view class="policy-item-main">
              <view class="policy-item-header">
                <text class="policy-product-name">{{item.productName || item.productType}}</text>
                <view class="policy-type-chip">
                  <text>{{item.productType}}</text>
                </view>
              </view>
              <view class="policy-insured-row">
                <text class="policy-insured-label">被保险人：</text>
                <text class="policy-insured-name {{item.insuredMemberId === null ? 'policy-insured-unconfirmed' : ''}}">{{item.insuredMemberName}}</text>
              </view>
              <view class="policy-summary-row" wx:if="{{item.policySummary}}">
                <text class="policy-summary-text">{{item.policySummary}}</text>
              </view>
              <view class="policy-completion-tip" wx:if="{{item.needsCompletion}}">
                <text class="policy-completion-text">待补充关键信息</text>
              </view>
              <view wx:else>
                <view class="policy-meta">
                  <text class="policy-meta-item">年缴 {{item.premium}}元</text>
                </view>
                <view class="policy-event-row">
                  <text class="policy-event-days policy-color-{{item.cardColorClass}}">
                    {{item.cardDaysText}}
                  </text>
                  <text class="policy-event-date" wx:if="{{item.cardEventDate}}">
                    {{item.cardEventDate}}
                  </text>
                </view>
              </view>
            </view>
            <view class="policy-item-right">
              <view class="policy-status-badge policy-status-{{item.cardColorClass}}"
                    wx:if="{{item.cardStatus !== 'normal'}}">
                <text>{{item.cardStatusLabel}}</text>
              </view>
              <view class="policy-action-btn"
                    data-id="{{item.id}}"
                    bindtap="onPolicyAction">
                <text>···</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 保障状态组 -->
      <view class="section-card" wx:if="{{!isNew}}">
        <view class="section-header">
          <text class="section-title">保障状态</text>
          <text class="section-hint">按被保险人统计</text>
        </view>

        <view wx:if="{{coverageByMember.length === 0}}" class="empty-hint">
          <text>暂无有效保单数据</text>
        </view>

        <view wx:else>
          <view class="coverage-member-group" wx:for="{{coverageByMember}}" wx:key="memberId">
            <view class="coverage-member-header">
              <text class="coverage-member-name">{{item.memberName}}</text>
            </view>
            <view class="coverage-member-chips">
              <view class="coverage-chip coverage-chip-configured"
                    wx:for="{{item.chips}}" wx:for-item="chip" wx:key="key">
                <text class="coverage-chip-key">{{chip.key}}</text>
                <text class="coverage-chip-val">已配置</text>
              </view>
            </view>
          </view>
        </view>
      </view>

    </view>

    <!-- ===== 沟通 Tab ===== -->
    <view wx:if="{{activeTab === 'timeline'}}">
      <view class="section-card">
        <view class="section-header">
          <text class="section-title">沟通记录</text>
        </view>

        <view wx:if="{{timeline.length === 0}}" class="empty-hint">
          <text>暂无沟通记录</text>
        </view>

        <view class="timeline" wx:else>
          <view class="timeline-item" wx:for="{{timelineVisible}}" wx:key="id">
            <view class="timeline-dot {{item.type === 'planned' ? 'dot-large' : 'dot-small'}}"></view>
            <view class="timeline-content">
              <view class="timeline-meta">
                <text class="timeline-date">{{item.date}}{{item.time ? ' ' + item.time : ''}}</text>
                <text class="timeline-type">{{item.type === 'planned' ? '计划拜访' : '临时沟通'}} · {{item.way}}</text>
                <text class="timeline-edit-btn" data-id="{{item.id}}" bindtap="onEditRecordTap">编辑</text>
              </view>
              <text class="timeline-goal" wx:if="{{item.goal}}">目标：{{item.goal}}</text>
              <text class="timeline-summary">{{item.summary}}</text>
              <text class="timeline-stage" wx:if="{{item.stageChange}}">阶段：{{item.stageChange}}</text>
              <text class="timeline-next" wx:if="{{item.nextDate}}">下次：{{item.nextDate}}</text>
            </view>
          </view>
          <view class="expand-btn" wx:if="{{!timelineExpanded && timelineTotal > 5}}" bindtap="onExpandTimeline">
            <text>展开全部（共{{timelineTotal}}条）</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 异议 Tab ===== -->
    <view wx:if="{{activeTab === 'objection'}}">
      <view class="section-card">
        <view class="section-header">
          <text class="section-title">异议记录</text>
          <view class="edit-btn" bindtap="onAddObjection">
            <text>+ 新增</text>
          </view>
        </view>

        <view wx:if="{{customerObjections.length === 0}}" class="empty-hint">
          <text>暂无异议记录</text>
        </view>

        <view class="objection-list" wx:else>
          <view class="objection-item" wx:for="{{customerObjections}}" wx:key="id"
                bindtap="onObjectionTap" data-id="{{item.id}}">
            <view class="obj-header">
              <text class="obj-category-tag">{{item.category}}</text>
              <text class="obj-result-tag obj-result-{{item.resultClass}}" wx:if="{{item.latestResult}}">{{item.latestResult}}</text>
              <text class="obj-count" wx:if="{{item.count > 1}}">{{item.count}}次</text>
            </view>
            <text class="obj-content">{{item.content}}</text>
            <view class="obj-footer">
              <text class="obj-solution" wx:if="{{item.solution}}">话术：{{item.solution}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 计划 Tab ===== -->
    <view wx:if="{{activeTab === 'plan'}}">
      <view class="section-card">
        <view class="section-header">
          <text class="section-title">下一步计划</text>
        </view>

        <view wx:if="{{customerPlans.length === 0}}" class="empty-hint">
          <text>暂无待执行计划</text>
        </view>

        <view class="plan-list" wx:else>
          <view class="plan-item" wx:for="{{customerPlans}}" wx:key="id">
            <view class="plan-item-header">
              <view class="plan-item-meta">
                <text class="plan-date {{item.isOverdue ? 'plan-date-overdue' : ''}}">{{item.plan_date}}{{item.plan_time ? ' ' + item.plan_time : ''}}</text>
                <text class="plan-way">{{item.visit_way}}</text>
              </view>
              <view wx:if="{{item.isOverdue}}" class="plan-overdue-badge">逾期</view>
            </view>
            <text class="plan-goal-text" wx:if="{{item.goal}}">{{item.goal}}</text>
            <view class="plan-item-actions">
              <view class="plan-act-btn plan-act-primary" data-id="{{item.id}}" bindtap="onExecutePlanFromDetail">完成记录</view>
              <view class="plan-act-btn" data-id="{{item.id}}" bindtap="onEditPlanFromDetail">修改</view>
              <view class="plan-act-btn plan-act-danger" data-id="{{item.id}}" bindtap="onDeletePlanFromDetail">删除</view>
            </view>
          </view>
        </view>
      </view>
    </view>

  </block>

  <!-- 添加计划底部 sheet -->
  <view class="plan-sheet" wx:if="{{showPlanSheet}}">
    <view class="plan-sheet-mask" bindtap="onPlanSheetCancel"></view>
    <view class="plan-sheet-content card">
      <view class="plan-sheet-header">
        <text class="plan-sheet-title">{{planSheetMode === 'edit' ? '修改拜访计划' : '添加拜访计划'}}</text>
        <text class="plan-sheet-close" bindtap="onPlanSheetCancel">×</text>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">客户</text>
        <text class="plan-sheet-value">{{customerName}}</text>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">日期</text>
        <picker mode="date" value="{{planSheetDate}}" bindchange="onPlanSheetDateChange">
          <text class="plan-sheet-value plan-sheet-picker">{{planSheetDate}} ▾</text>
        </picker>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">时间</text>
        <picker mode="time" value="{{planSheetTime}}" start="06:00" end="23:30" bindchange="onPlanSheetTimeChange">
          <text class="plan-sheet-value {{planSheetTime ? 'plan-sheet-picker' : 'plan-sheet-placeholder'}}">{{planSheetTime || '请选择'}} ▾</text>
        </picker>
      </view>
      <view class="plan-sheet-row">
        <text class="plan-sheet-label">方式</text>
        <view class="plan-sheet-chips">
          <view wx:for="{{visitWayOptions}}" wx:key="*this"
            class="plan-sheet-chip {{planSheetVisitWay === item ? 'active' : ''}}"
            data-way="{{item}}" bindtap="onPlanSheetWayChange">{{item}}</view>
        </view>
      </view>
      <view class="plan-sheet-field">
        <view class="plan-sheet-goal-header">
          <text class="plan-sheet-label">拜访目标</text>
          <text class="plan-sheet-goal-count">{{planSheetGoal.length}}/20</text>
        </view>
        <textarea class="plan-sheet-goal-input"
          placeholder="请输入本次拜访目标（选填）..."
          placeholder-class="plan-sheet-placeholder"
          value="{{planSheetGoal}}"
          maxlength="20"
          bindinput="onPlanSheetGoalInput"
          auto-height/>
      </view>
      <view class="plan-sheet-actions">
        <view class="plan-sheet-btn plan-sheet-btn-cancel" bindtap="onPlanSheetCancel">
          <text class="plan-sheet-btn-text">取消</text>
        </view>
        <view class="plan-sheet-btn plan-sheet-btn-confirm" bindtap="onPlanSheetConfirm">
          <text class="plan-sheet-btn-text">{{planSheetMode === 'edit' ? '保存' : '确认添加'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 选择异议 sheet -->
  <view class="obj-sheet" wx:if="{{showObjSheet}}">
    <view class="obj-sheet-mask" bindtap="onObjSheetCancel"></view>
    <view class="obj-sheet-content card">
      <text class="obj-sheet-title">选择异议</text>
      <scroll-view class="obj-sheet-list" scroll-y>
        <view class="obj-sheet-item {{item.selected ? 'selected' : ''}}"
              wx:for="{{objSheetList}}" wx:key="id"
              data-index="{{index}}" bindtap="onObjSheetItemTap">
          <view class="obj-sheet-check">
            <text wx:if="{{item.selected}}">✓</text>
          </view>
          <view class="obj-sheet-info">
            <text class="obj-sheet-content-text">{{item.content}}</text>
            <view class="obj-sheet-meta">
              <text class="obj-sheet-category">{{item.category}}</text>
              <text class="obj-sheet-count" wx:if="{{item.count > 0}}">出现 {{item.count}} 次</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="obj-sheet-actions">
        <view class="obj-sheet-btn-new" bindtap="onObjSheetCreateNew">
          <text>+ 新建异议</text>
        </view>
        <view class="obj-sheet-btn-confirm" bindtap="onObjSheetConfirm">
          <text>确认</text>
        </view>
      </view>
    </view>
  </view>
  <!-- 编辑沟通摘要 sheet -->
  <view class="plan-sheet" wx:if="{{showRecordEditSheet}}">
    <view class="plan-sheet-mask" bindtap="onRecordEditCancel"></view>
    <view class="plan-sheet-content card">
      <text class="plan-sheet-title">编辑沟通摘要</text>
      <textarea class="record-edit-textarea"
                value="{{recordEditSummary}}"
                placeholder="请输入沟通摘要"
                bindinput="onRecordEditSummaryInput"
                auto-height
                maxlength="500"/>
      <view class="plan-sheet-actions">
        <view class="plan-sheet-btn plan-sheet-btn-cancel" bindtap="onRecordEditCancel">
          <text class="plan-sheet-btn-text">取消</text>
        </view>
        <view class="plan-sheet-btn plan-sheet-btn-confirm" bindtap="onRecordEditConfirm">
          <text class="plan-sheet-btn-text">{{isSaving ? '保存中...' : '保存'}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
