/* pages/segment-edit/index.wxss */
.page-wrap { padding: var(--spacing-page); padding-bottom: 200rpx; }
.section-card { background: var(--color-card); border-radius: var(--radius-card); padding: var(--spacing-card); margin-bottom: var(--spacing-gap); }
.field-label-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.field-label { font-size: 30rpx; font-weight: 500; color: var(--color-text-primary); }
.field-label-sub { font-size: 24rpx; color: var(--color-text-secondary); margin-left: 12rpx; }
.required-mark { color: var(--color-danger); margin-left: 4rpx; }
.name-input { border: 2rpx solid var(--color-border); border-radius: var(--radius-input); padding: 16rpx 20rpx; font-size: 28rpx; color: var(--color-text-primary); }
.color-chips { display: flex; gap: 16rpx; flex-wrap: wrap; }
.color-chip { padding: 8rpx 24rpx; border-radius: 32rpx; border: 2rpx solid var(--color-border); font-size: 26rpx; }
.color-chip.selected { border-color: var(--color-primary); color: var(--color-primary); font-weight: 500; }
.color-chip-gold.selected   { border-color: var(--color-warning);   color: var(--color-warning); }
.color-chip-purple.selected { border-color: var(--color-purple);    color: var(--color-purple); }
.color-chip-blue.selected   { border-color: var(--color-secondary); color: var(--color-secondary); }
.color-chip-green.selected  { border-color: var(--color-success);   color: var(--color-success); }
.color-chip-gray.selected   { border-color: var(--color-neutral);   color: var(--color-text-secondary); }
.rule-list { margin-bottom: 16rpx; }
.rule-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-border); }
.rule-item-content { flex: 1; font-size: 26rpx; color: var(--color-text-primary); }
.rule-field { font-weight: 500; }
.rule-op { color: var(--color-text-secondary); }
.rule-value { color: var(--color-primary); }
.rule-delete { padding: 8rpx 16rpx; color: var(--color-danger); font-size: 32rpx; }
.add-rule-btn { text-align: center; padding: 16rpx; color: var(--color-primary); font-size: 28rpx; border: 2rpx dashed var(--color-primary); border-radius: var(--radius-input); }
.sort-row { display: flex; align-items: center; gap: 16rpx; }
.sort-picker { flex: 1; padding: 16rpx; border: 2rpx solid var(--color-border); border-radius: var(--radius-input); font-size: 26rpx; color: var(--color-text-primary); }
.sort-order-btn { padding: 16rpx 24rpx; border: 2rpx solid var(--color-primary); border-radius: var(--radius-input); color: var(--color-primary); font-size: 26rpx; }
.preview-bar { display: flex; justify-content: space-between; align-items: center; padding: 20rpx var(--spacing-page); background: var(--color-card); border-radius: var(--radius-card); margin-bottom: 8rpx; }
.preview-count { font-size: 26rpx; color: var(--color-text-primary); font-weight: 500; }
.preview-toggle { font-size: 24rpx; color: var(--color-primary); }
.preview-list { background: var(--color-card); border-radius: var(--radius-card); padding: 8rpx var(--spacing-card); margin-bottom: var(--spacing-gap); }
.preview-item { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid var(--color-border); }
.preview-item:last-child { border-bottom: none; }
.preview-name { font-size: 28rpx; color: var(--color-text-primary); }
.preview-stage { font-size: 24rpx; color: var(--color-text-secondary); }

/* 保存按钮底座：白色背景 + 向上阴影 + 安全区，z-index 低于弹窗 */
.save-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 24rpx var(--spacing-page); padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: #ffffff; box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05); z-index: 10; }
.save-btn { background: var(--color-primary); color: #fff; border-radius: var(--radius-btn); font-size: 30rpx; font-weight: 500; }

/* 弹窗 wrapper：全屏覆盖，z-index 9999，确保盖住所有主页面元素 */
.rule-editor-wrapper { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999; }

/* 遮罩：绝对定位铺满 wrapper，rgba 背景不影响子元素透明度 */
.rule-editor-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 1; }

/* 内容区：绝对定位贴底，纯白背景，z-index 高于遮罩 */
.rule-editor-sheet { position: absolute; bottom: 0; left: 0; width: 100%; background: #ffffff; border-radius: var(--radius-panel) var(--radius-panel) 0 0; z-index: 2; box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.12); }

/* 表单区 */
.rule-editor-body { padding: 32rpx var(--spacing-page) 0; }
.rule-editor-title { font-size: 30rpx; font-weight: 500; color: var(--color-text-primary); display: block; margin-bottom: 24rpx; }
.rule-editor-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.rule-editor-row-value { align-items: flex-start; }
.rule-editor-row-value .rule-editor-label { padding-top: 10rpx; }
.rule-editor-label { width: 120rpx; font-size: 26rpx; color: var(--color-text-secondary); }
.rule-editor-picker { flex: 1; padding: 12rpx 16rpx; border: 2rpx solid var(--color-border); border-radius: var(--radius-input); font-size: 26rpx; color: var(--color-text-primary); }
.rule-value-chips { display: flex; flex-wrap: wrap; gap: 16rpx; flex: 1; }
.rule-value-chip { padding: 8rpx 20rpx; border-radius: var(--radius-badge); border: 2rpx solid var(--color-border); font-size: 24rpx; color: var(--color-text-secondary); margin: 4rpx 0; }
.rule-value-chip.selected { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-primary-light); font-weight: 500; }
.rule-value-input { flex: 1; border: 2rpx solid var(--color-border); border-radius: var(--radius-input); padding: 12rpx 16rpx; font-size: 26rpx; }

/* 系统预设：只读名称 */
.system-badge { font-size: 22rpx; color: var(--color-text-placeholder); background: var(--color-bg-page); border-radius: var(--radius-badge); padding: 2rpx 12rpx; margin-left: 12rpx; }
.name-readonly { font-size: 28rpx; color: var(--color-text-primary); display: block; padding: 4rpx 0; }
/* 系统预设：只读排序 */
.sort-picker-readonly { flex: 1; padding: 16rpx; border: 2rpx solid var(--color-border); border-radius: var(--radius-input); font-size: 26rpx; color: var(--color-text-placeholder); background: var(--color-bg-page); }
.sort-order-readonly { padding: 16rpx 24rpx; border: 2rpx solid var(--color-border); border-radius: var(--radius-input); color: var(--color-text-placeholder); font-size: 26rpx; background: var(--color-bg-page); }
.rule-editor-actions { display: flex; background: #ffffff; border-top: 1rpx solid var(--color-border); margin-top: 24rpx; padding-bottom: env(safe-area-inset-bottom); }
.rule-editor-btn { flex: 1; text-align: center; padding: 28rpx 0; font-size: 28rpx; }
.rule-editor-btn.cancel { color: var(--color-text-secondary); background: #ffffff; }
.rule-editor-btn.confirm { background: var(--color-primary); color: #ffffff; }
