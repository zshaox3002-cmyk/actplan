.customer-list {
  margin-top: 4px;
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48px 0;
}

.empty-text {
  font-size: var(--font-size-secondary);
  color: var(--color-text-placeholder);
}

/* ---- 确认面板 ---- */
.confirm-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.confirm-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.confirm-content {
  position: relative;
  width: 100%;
  padding: 20px var(--spacing-card);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
  z-index: 1;
}

.confirm-title {
  font-size: var(--font-size-module);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: 16px;
  display: block;
}

.confirm-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.confirm-label {
  font-size: var(--font-size-secondary);
  color: var(--color-text-secondary);
}

.confirm-value {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
}

.picker-value {
  color: var(--color-primary);
}

.confirm-actions {
  display: flex;
  gap: 12px;
  margin-top: 20px;
}

.action-btn {
  flex: 1;
  height: var(--height-button);
  border-radius: var(--radius-button);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cancel {
  background-color: var(--color-bg-page);
  border: 1px solid var(--color-border);
}

.btn-cancel .btn-text {
  color: var(--color-text-secondary);
}

.btn-confirm {
  background-color: var(--color-primary);
}

.btn-confirm .btn-text {
  color: var(--color-bg-card);
  font-weight: var(--font-weight-semibold);
}

.btn-text {
  font-size: var(--font-size-body);
}

/* ---- 时间选择 ---- */
.confirm-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label-optional {
  font-size: var(--font-size-helper);
  color: var(--color-text-placeholder);
  margin-left: 8rpx;
}

.confirm-value-row {
  display: flex;
  align-items: center;
}

.confirm-value.placeholder {
  color: var(--color-text-placeholder);
}

.confirm-goal-count { font-size: 22rpx; color: var(--color-text-placeholder); }
.confirm-goal-input {
  width: 100%;
  min-height: 80rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-input);
  font-size: 28rpx;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  box-sizing: border-box;
  line-height: 1.6;
}

.time-clear {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: var(--font-size-helper);
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  border-radius: var(--radius-badge);
}

.time-clear:active {
  background: var(--color-border);
}
