/* pages/record-new/index.wxss */

/* 只读信息区 */
.readonly-section {
  background: #EBF2FF;
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 8rpx 32rpx;
}
.readonly-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  border-bottom: 1rpx solid rgba(26,111,212,0.1);
}
.readonly-row:last-child { border-bottom: none; }
.readonly-label { font-size: 28rpx; color: #6B7280; }
.readonly-value { font-size: 30rpx; color: #111827; font-weight: 500; }
.plan-value { color: #1A6FD4; }

/* 通用 section 卡片 */
.section-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 16rpx 24rpx 0;
  padding: 28rpx 32rpx;
}

/* 字段标题行 */
.field-label-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.field-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}
.field-label-sub {
  font-size: 22rpx;
  color: #9CA3AF;
}
.required-dot {
  color: #EF4444;
  font-size: 28rpx;
}

/* 沟通摘要输入框 */
.summary-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  color: #111827;
  line-height: 1.7;
}

/* 跟进阶段提示文字 */
.field-hint {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
}

/* 日期选择行 */
.date-picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
}
.date-picker-row .placeholder { color: #9CA3AF; font-size: 30rpx; }
.date-picker-row .selected { color: #111827; font-size: 30rpx; }
.chevron-icon { width: 28rpx; height: 28rpx; opacity: 0.4; }

/* 异议列表 */
.objection-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}
.obj-content { font-size: 28rpx; color: #374151; flex: 1; }
.obj-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 36rpx;
}
.add-objection-btn {
  margin-top: 16rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #C7D7F5;
  border-radius: 12rpx;
  color: #1A6FD4;
  font-size: 28rpx;
}

/* 保存按钮 */
.save-bar {
  padding: 32rpx 24rpx 48rpx;
}
.save-btn {
  width: 100%;
  height: 96rpx;
  background: #1A6FD4;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
