<!-- pages/policy-edit/index.wxml -->
<view class="page-wrap">

  <!-- 草稿提示条 -->
  <view class="draft-tip-bar" wx:if="{{showDraftTip}}">
    <text>来自 {{visitRecordDate}} 拜访记录，请补全保单信息</text>
  </view>

  <!-- 险种 -->
  <view class="section-card">
    <view class="field-label-row">
      <text class="field-label">险种</text>
      <text class="required-mark">*</text>
    </view>
    <picker mode="selector"
            range="{{categoryOptions}}"
            value="{{categoryIndex}}"
            bindchange="onCategoryChange">
      <view class="picker-row">
        <text class="picker-value">{{categoryOptions[categoryIndex] || '请选择险种'}}</text>
        <text class="picker-arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 被保险人 -->
  <view class="section-card">
    <view class="field-label-row">
      <text class="field-label">被保险人</text>
      <text class="required-mark">*</text>
    </view>
    <view class="picker-row" bindtap="onInsuredMemberTap">
      <text class="picker-value {{insuredMemberId === null ? 'placeholder' : ''}}">
        {{insuredMemberName || '请选择被保险人'}}
      </text>
      <text class="picker-arrow">▾</text>
    </view>
  </view>

  <!-- 产品名 -->
  <view class="section-card">
    <view class="field-label-row">
      <text class="field-label">产品名</text>
      <text class="required-mark">*</text>
    </view>
    <input class="text-input"
           value="{{productName}}"
           bindinput="onProductNameInput"
           placeholder="如：友邦传世盈佳"/>
  </view>

  <!-- 生效日期 -->
  <view class="section-card">
    <view class="field-label-row">
      <text class="field-label">生效日期</text>
      <text class="required-mark">*</text>
    </view>
    <picker mode="date" value="{{effectiveDate}}" bindchange="onEffectiveDateChange">
      <view class="picker-row">
        <text class="picker-value {{effectiveDate ? '' : 'placeholder'}}">{{effectiveDate || '请选择生效日期'}}</text>
        <text class="picker-arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 保费 -->
  <view class="section-card">
    <view class="field-label-row">
      <text class="field-label">年缴保费（元）</text>
      <text class="required-mark">*</text>
    </view>
    <input class="text-input"
           type="digit"
           value="{{premium}}"
           bindinput="onPremiumInput"
           placeholder="年缴金额"/>
  </view>

  <!-- 自动填充区分隔 -->
  <view class="auto-fill-divider">
    <text>── 自动填充，点击可改 ──</text>
  </view>

  <!-- 保障期限（折叠展开） -->
  <view class="section-card">
    <view class="term-row" bindtap="onToggleCoverageTermEdit">
      <text class="field-label">保障期限</text>
      <view class="term-row-right">
        <text class="term-display-text">{{coverageTermDisplay}}</text>
        <text class="picker-arrow">{{coverageTermEditing ? '▴' : '▾'}}</text>
      </view>
    </view>
    <block wx:if="{{coverageTermEditing}}">
      <view class="term-edit-block">
        <picker mode="selector"
                range="{{coverageTermTypeOptions}}"
                value="{{coverageTermTypeIndex}}"
                bindchange="onCoverageTermTypeChange">
          <view class="picker-row">
            <text class="picker-value">{{coverageTermTypeOptions[coverageTermTypeIndex]}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
        <input wx:if="{{coverageTerm.type !== 'lifetime'}}"
               class="text-input term-value-input"
               type="number"
               value="{{coverageTerm.value}}"
               bindinput="onCoverageTermValueInput"
               placeholder="请输入数值（年/岁）"/>
      </view>
    </block>
  </view>

  <!-- 缴费期限（折叠展开，部分险种隐藏） -->
  <view class="section-card" wx:if="{{showPaymentTerm}}">
    <view class="term-row" bindtap="onTogglePaymentTermEdit">
      <text class="field-label">缴费期限</text>
      <view class="term-row-right">
        <text class="term-display-text">{{paymentTermDisplay}}</text>
        <text class="picker-arrow">{{paymentTermEditing ? '▴' : '▾'}}</text>
      </view>
    </view>
    <block wx:if="{{paymentTermEditing}}">
      <view class="term-edit-block">
        <picker mode="selector"
                range="{{paymentTermTypeOptions}}"
                value="{{paymentTermTypeIndex}}"
                bindchange="onPaymentTermTypeChange">
          <view class="picker-row">
            <text class="picker-value">{{paymentTermTypeOptions[paymentTermTypeIndex]}}</text>
            <text class="picker-arrow">▾</text>
          </view>
        </picker>
        <input wx:if="{{paymentTerm.type === 'years'}}"
               class="text-input term-value-input"
               type="number"
               value="{{paymentTerm.value}}"
               bindinput="onPaymentTermValueInput"
               placeholder="请输入缴费年数"/>
      </view>
    </block>
  </view>

  <view class="save-bar">
    <button class="save-btn" disabled="{{isSaving}}" bindtap="onSave">{{isSaving ? '保存中...' : '保存'}}</button>
  </view>

  <!-- 被保险人选择弹窗 -->
  <view class="modal-mask" wx:if="{{showMemberPicker}}" bindtap="onMemberPickerClose"></view>
  <view class="bottom-sheet" wx:if="{{showMemberPicker}}">
    <view class="sheet-header">
      <text class="sheet-title">选择被保险人</text>
      <text class="sheet-close" bindtap="onMemberPickerClose">✕</text>
    </view>
    <view class="member-list">
      <view class="member-item {{item.id === insuredMemberId ? 'member-item-active' : ''}}"
            wx:for="{{insuredMembers}}" wx:key="id"
            data-id="{{item.id}}"
            data-name="{{item.display_name}}"
            bindtap="onMemberSelect">
        <text class="member-relation">{{item.relation}}</text>
        <text class="member-name">{{item.display_name}}</text>
        <text class="member-check" wx:if="{{item.id === insuredMemberId}}">✓</text>
      </view>
    </view>
    <view class="add-member-btn" bindtap="onAddMemberTap">
      <text>+ 新增保障对象</text>
    </view>
  </view>

  <!-- 新增保障对象弹窗 -->
  <view class="modal-mask" wx:if="{{showAddMemberSheet}}" bindtap="onAddMemberCancel"></view>
  <view class="bottom-sheet" wx:if="{{showAddMemberSheet}}">
    <view class="sheet-header">
      <text class="sheet-title">新增保障对象</text>
      <text class="sheet-close" bindtap="onAddMemberCancel">✕</text>
    </view>
    <view class="sheet-body">
      <view class="field-label-row">
        <text class="field-label">关系</text>
        <text class="required-mark">*</text>
      </view>
      <view class="relation-chips">
        <view class="relation-chip {{newMemberRelationIndex === index ? 'relation-chip-active' : ''}}"
              wx:for="{{relationOptions}}" wx:key="*this"
              data-index="{{index}}"
              bindtap="onNewMemberRelationChange">
          <text>{{item}}</text>
        </view>
      </view>
      <view class="field-label-row" style="margin-top: 32rpx;">
        <text class="field-label">显示名称</text>
      </view>
      <input class="text-input"
             value="{{newMemberDisplayName}}"
             bindinput="onNewMemberDisplayNameInput"
             placeholder="自动生成，可修改"/>
    </view>
    <view class="sheet-footer">
      <button class="sheet-cancel-btn" bindtap="onAddMemberCancel">取消</button>
      <button class="sheet-confirm-btn" bindtap="onAddMemberConfirm">确认</button>
    </view>
  </view>

</view>
