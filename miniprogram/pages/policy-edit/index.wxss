/* pages/policy-edit/index.wxss */
.page-wrap { padding: var(--spacing-page); padding-bottom: 160rpx; }
.section-card { background: var(--color-card); border-radius: var(--radius-card); padding: var(--spacing-card); margin-bottom: var(--spacing-gap); }
.field-label-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.field-label { font-size: 30rpx; font-weight: 500; color: var(--color-text-primary); }
.required-mark { color: var(--color-danger); margin-left: 4rpx; }
.text-input { border: 2rpx solid var(--color-border); border-radius: var(--radius-input); padding: 0 20rpx; font-size: 28rpx; color: var(--color-text-primary); width: 100%; box-sizing: border-box; height: 88rpx; line-height: 88rpx; }
.picker-row { display: flex; justify-content: space-between; align-items: center; border: 2rpx solid var(--color-border); border-radius: var(--radius-input); padding: 0 20rpx; height: 88rpx; }
.picker-value { font-size: 28rpx; color: var(--color-text-primary); }
.picker-value.placeholder { color: var(--color-placeholder); }
.picker-arrow { font-size: 24rpx; color: var(--color-text-secondary); }
.save-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 24rpx var(--spacing-page); padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: #ffffff; box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05); }
.save-btn { background: var(--color-primary); color: #fff; border-radius: var(--radius-btn); font-size: 30rpx; font-weight: 500; }

/* 草稿提示条 */
.draft-tip-bar { background: var(--color-warning-light, #FFF7E6); color: var(--color-warning); font-size: var(--font-size-helper, 22rpx); padding: 16rpx var(--spacing-page); margin-bottom: 8rpx; border-radius: var(--radius-sm, 8rpx); }

/* 自动填充区分隔 */
.auto-fill-divider { text-align: center; font-size: var(--font-size-helper, 22rpx); color: var(--color-text-placeholder); padding: 8rpx 0 4rpx; }

/* 期限展示行（折叠态） */
.term-row { display: flex; align-items: center; justify-content: space-between; }
.term-row-right { display: flex; align-items: center; gap: 8rpx; }
.term-display-text { font-size: 28rpx; color: var(--color-primary); }

/* 折叠编辑区 */
.term-edit-block { border-top: 1rpx solid var(--color-border); padding-top: var(--spacing-sm, 16rpx); margin-top: var(--spacing-sm, 16rpx); display: flex; flex-direction: column; gap: 16rpx; }
.term-value-input { margin-top: 12rpx; }

/* 被保险人弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 100; }
.bottom-sheet { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-radius: var(--radius-card) var(--radius-card) 0 0; z-index: 101; padding-bottom: env(safe-area-inset-bottom); }
.sheet-header { display: flex; justify-content: space-between; align-items: center; padding: 32rpx var(--spacing-page) 24rpx; border-bottom: 1rpx solid var(--color-border); }
.sheet-title { font-size: 30rpx; font-weight: 500; color: var(--color-text-primary); }
.sheet-close { font-size: 28rpx; color: var(--color-text-secondary); padding: 8rpx; }
.member-list { max-height: 480rpx; overflow-y: auto; }
.member-item { display: flex; align-items: center; padding: 28rpx var(--spacing-page); border-bottom: 1rpx solid var(--color-border); }
.member-item:last-child { border-bottom: none; }
.member-item-active { background: var(--color-primary-light); }
.member-relation { font-size: 24rpx; color: var(--color-text-secondary); margin-right: 12rpx; min-width: 60rpx; }
.member-name { flex: 1; font-size: 28rpx; color: var(--color-text-primary); }
.member-check { font-size: 28rpx; color: var(--color-primary); font-weight: 600; }
.add-member-btn { padding: 28rpx var(--spacing-page); text-align: center; font-size: 28rpx; color: var(--color-primary); border-top: 1rpx solid var(--color-border); }
.relation-chips { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 8rpx 0; }
.relation-chip { padding: 10rpx 24rpx; border-radius: 32rpx; border: 1rpx solid var(--color-border); font-size: 26rpx; color: var(--color-text-secondary); }
.relation-chip-active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
.sheet-body { padding: 32rpx var(--spacing-page); }
.sheet-footer { display: flex; gap: 24rpx; padding: 24rpx var(--spacing-page); border-top: 1rpx solid var(--color-border); }
.sheet-cancel-btn { flex: 1; background: var(--color-bg-muted); color: var(--color-text-secondary); border-radius: var(--radius-btn); font-size: 28rpx; }
.sheet-confirm-btn { flex: 1; background: var(--color-primary); color: #fff; border-radius: var(--radius-btn); font-size: 28rpx; }
