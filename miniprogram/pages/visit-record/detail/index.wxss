page { background: var(--color-bg-page); }

.page-wrap {
  padding: 0 0 48rpx;
}

/* ① 顶部客户信息条 */
.customer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-primary);
  padding: 32rpx 32rpx;
  margin-bottom: 20rpx;
}
.customer-bar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.customer-info {
  display: flex;
  flex-direction: column;
}
.customer-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-bg-card);
  display: block;
  margin-bottom: 8rpx;
}
.customer-bar-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.view-customer-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}
.arrow {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

/* ② ③ ④ 通用卡片 */
.section-card {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  margin: 0 24rpx 16rpx;
  padding: 32rpx;
}
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-placeholder);
  letter-spacing: 2rpx;
  text-transform: uppercase;
  display: block;
  margin-bottom: 24rpx;
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  border-bottom: 1rpx solid var(--color-border);
}
.info-row:last-of-type { border-bottom: none; }
.summary-row { border-bottom: none; margin-bottom: 8rpx; }
.info-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
  width: 160rpx;
}
.info-value {
  font-size: 30rpx;
  color: var(--color-text-primary);
  text-align: right;
}
.summary-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 1.8;
  display: block;
  padding-bottom: 8rpx;
}

/* 跟进阶段徽章（小） */
.stage-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
/* 跟进阶段徽章（大） */
.stage-badge-lg {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.stage-blue   { background: var(--stage-present-bg); color: var(--stage-present-text); }
.stage-purple { background: var(--stage-closing-bg); color: var(--stage-closing-text); }
.stage-orange { background: var(--priority-p1-bg); color: var(--priority-p1-text); }
.stage-teal   { background: var(--color-primary-light); color: var(--color-primary-dark); }
.stage-green  { background: var(--stage-deal-bg); color: var(--stage-deal-text); }
.stage-red    { background: var(--priority-p0-bg); color: var(--color-danger); }
.stage-gray   { background: var(--stage-meet-bg); color: var(--stage-meet-text); }

/* 自动创建计划链接 */
.plan-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--color-primary-light);
  border-radius: 12rpx;
  border: 1rpx solid var(--color-primary);
}
.plan-link-icon { font-size: 28rpx; }
.plan-link-text { font-size: 26rpx; color: var(--color-primary); flex: 1; }
.plan-link-arrow { font-size: 28rpx; color: var(--color-primary); }
.next-date { color: var(--color-primary); font-weight: 500; }

/* ④ 异议列表 */
.objection-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.objection-item:last-child { border-bottom: none; }
.obj-left { flex: 1; padding-right: 16rpx; }
.obj-content { font-size: 28rpx; color: var(--color-text-primary); line-height: 1.6; }
.obj-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.tag-red    { background: var(--priority-p0-bg); color: var(--color-danger); }
.tag-blue   { background: var(--stage-present-bg); color: var(--stage-present-text); }
.tag-yellow { background: var(--priority-p1-bg); color: var(--priority-p1-text); }
.tag-purple { background: var(--stage-closing-bg); color: var(--stage-closing-text); }
.tag-green  { background: var(--stage-deal-bg); color: var(--stage-deal-text); }
.tag-gray   { background: var(--color-bg-page); color: var(--color-text-secondary); }

/* 异议空态 */
.obj-empty {
  padding: 24rpx 0 8rpx;
}
.obj-empty-text {
  font-size: 26rpx;
  color: var(--color-text-placeholder);
}

/* 底部记录时间 */
.record-time {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-placeholder);
  margin-top: 8rpx;
  padding: 0 24rpx;
}
