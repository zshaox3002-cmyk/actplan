/* pages/objection/select/index.wxss */

page { background: var(--color-bg-page); }

.page-wrap { padding-bottom: 160rpx; }

/* 搜索栏 */
.search-bar { padding: 20rpx 24rpx 0; }
.search-input {
  background: var(--color-bg-card);
  border-radius: var(--radius-input);
  padding: 0 24rpx;
  height: 72rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 分类标签 */
.chip-scroll { padding: 20rpx 0; white-space: nowrap; }
.chip-list { display: inline-flex; padding: 0 24rpx; gap: 12rpx; }
.chip-item {
  display: inline-flex;
  padding: 10rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.chip-item.active { background: var(--color-primary); color: var(--color-bg-card); }

/* 异议列表 */
.objection-list { padding: 0 24rpx; display: flex; flex-direction: column; gap: 12rpx; }

.obj-select-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 24rpx;
  transition: all 0.15s ease;
}
.obj-select-item.selected {
  border: 2rpx solid var(--color-primary);
}

.obj-select-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.obj-title {
  font-size: 28rpx;
  color: var(--color-text-primary);
  flex: 1;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 官方标识 */
.obj-official { flex-shrink: 0; }
.official-text {
  font-size: 18rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

/* 勾选圆 */
.obj-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-disabled);
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.obj-check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.check-icon {
  font-size: 22rpx;
  color: var(--color-bg-card);
  line-height: 1;
}

/* 分类标签 */
.obj-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.tag-red    { background: var(--priority-p0-bg); color: var(--priority-p0-text); }
.tag-blue   { background: var(--stage-present-bg); color: var(--stage-present-text); }
.tag-yellow { background: var(--priority-p1-bg); color: var(--priority-p1-text); }
.tag-purple { background: var(--color-secondary-light); color: var(--color-secondary); }
.tag-green  { background: var(--stage-deal-bg); color: var(--stage-deal-text); }
.tag-gray   { background: var(--stage-meet-bg); color: var(--stage-meet-text); }

/* 空状态 */
.empty-hint {
  text-align: center;
  padding: 60rpx 0;
}
.empty-hint text {
  font-size: 26rpx;
  color: var(--color-text-placeholder);
}

/* 新增入口 */
.add-new-btn {
  margin: 20rpx 24rpx 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--color-primary-light);
  border-radius: var(--radius-card);
  color: var(--color-primary);
  font-size: 28rpx;
}
.add-new-btn text { letter-spacing: 1rpx; }

/* 底部确认 */
.confirm-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx 48rpx;
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border);
}
.confirm-btn {
  height: 96rpx;
  background: var(--color-primary);
  border-radius: var(--radius-button);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-bg-card);
}
.confirm-btn.disabled {
  background: var(--color-border);
  color: var(--color-text-placeholder);
}
