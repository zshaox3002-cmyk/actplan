/* pages/objection/select/index.wxss */

page { background: #F5F7FA; }

.page-wrap { padding-bottom: 160rpx; }

/* 搜索栏 */
.search-bar { padding: 20rpx 24rpx 0; }
.search-input {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 72rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 分类标签 */
.chip-scroll { padding: 20rpx 0; white-space: nowrap; }
.chip-list { display: inline-flex; padding: 0 24rpx; gap: 12rpx; }
.chip-item {
  display: inline-flex;
  padding: 10rpx 24rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4B5563;
}
.chip-item.active { background: #1A6FD4; color: #fff; }

/* 异议列表 */
.objection-list { padding: 0 24rpx; display: flex; flex-direction: column; gap: 12rpx; }

.obj-select-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all 0.15s ease;
}
.obj-select-item.selected {
  border: 2rpx solid #1A6FD4;
}

.obj-select-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.obj-title {
  font-size: 28rpx;
  color: #111827;
  flex: 1;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 官方标识 */
.obj-official { flex-shrink: 0; }
.official-text {
  font-size: 18rpx;
  color: #1A6FD4;
  background: #DBEAFE;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

/* 勾选圆 */
.obj-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D5DB;
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.obj-check.checked {
  background: #1A6FD4;
  border-color: #1A6FD4;
}
.check-icon {
  font-size: 22rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* 分类标签 */
.obj-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.tag-red    { background: #FEE2E2; color: #DC2626; }
.tag-blue   { background: #DBEAFE; color: #1D4ED8; }
.tag-yellow { background: #FEF3C7; color: #D97706; }
.tag-purple { background: #EDE9FE; color: #7C3AED; }
.tag-green  { background: #D1FAE5; color: #059669; }
.tag-gray   { background: #F3F4F6; color: #6B7280; }

/* 空状态 */
.empty-hint {
  text-align: center;
  padding: 60rpx 0;
}
.empty-hint text {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* 新增入口 */
.add-new-btn {
  margin: 20rpx 24rpx 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #C7D7F5;
  border-radius: 16rpx;
  color: #1A6FD4;
  font-size: 28rpx;
}
.add-new-btn text { letter-spacing: 1rpx; }

/* 底部确认 */
.confirm-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx 48rpx;
  background: #fff;
  border-top: 1rpx solid #F3F4F6;
}
.confirm-btn {
  height: 96rpx;
  background: #1A6FD4;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}
.confirm-btn.disabled {
  background: #E5E7EB;
  color: #9CA3AF;
}
