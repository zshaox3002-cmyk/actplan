<view class="calendar-page">
  <!-- 顶部：视图切换 -->
  <view class="view-toggle">
    <view class="toggle-pill">
      <view class="toggle-item {{viewMode === 'week' ? 'active' : ''}}" bindtap="onToggleView" data-mode="week">周视图</view>
      <view class="toggle-item {{viewMode === 'month' ? 'active' : ''}}" bindtap="onToggleView" data-mode="month">月视图</view>
    </view>
  </view>

  <!-- 日历区域 -->
  <view class="calendar-container">
    <!-- 导航栏 -->
    <view class="calendar-header">
      <view class="nav-btn" bindtap="onPrevPage">◀</view>
      <view class="calendar-title">
        <text wx:if="{{viewMode === 'week'}}">{{anchorDate.substring(0, 7)}}</text>
        <text wx:if="{{viewMode === 'month'}}">{{anchorDate.substring(0, 7)}}</text>
      </view>
      <view class="nav-btn" bindtap="onNextPage">▶</view>
    </view>

    <!-- 周视图 -->
    <view wx:if="{{viewMode === 'week'}}" class="week-view">
      <view class="week-row">
        <view wx:for="{{weekDays}}" wx:key="date" class="day-cell {{item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}" bindtap="onDateTap" data-date="{{item.date}}">
          <view class="day-number">{{item.date.substring(5)}}</view>
          <view wx:if="{{item.isMarked}}" class="day-mark"></view>
        </view>
      </view>
    </view>

    <!-- 月视图 -->
    <view wx:if="{{viewMode === 'month'}}" class="month-view">
      <view class="month-header">
        <view class="weekday-label">一</view>
        <view class="weekday-label">二</view>
        <view class="weekday-label">三</view>
        <view class="weekday-label">四</view>
        <view class="weekday-label">五</view>
        <view class="weekday-label">六</view>
        <view class="weekday-label">日</view>
      </view>
      <view class="month-grid">
        <view wx:for="{{monthDays}}" wx:key="date" class="month-cell {{!item.isCurrentMonth ? 'other-month' : ''}} {{item.isSelected ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}" bindtap="onDateTap" data-date="{{item.date}}">
          <view class="cell-day">{{item.day}}</view>
          <view wx:if="{{item.isMarked}}" class="cell-mark"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 事件列表 -->
  <view class="events-section">
    <view class="events-header">
      <text class="events-date">{{selectedDate}}</text>
      <text class="events-count">{{events.length}} 件事</text>
    </view>

    <view wx:if="{{events.length === 0}}" class="empty-wrap">
      <empty-state text="暂无计划和记录" />
    </view>

    <view wx:for="{{events}}" wx:key="id" class="event-card {{item.status === 'completed' ? 'completed' : ''}}" bindtap="onEventTap" data-event-id="{{item.id}}">
      <!-- 左栏：时间 -->
      <view class="event-time">{{item.time}}</view>

      <!-- 中栏：主信息 -->
      <view class="event-main">
        <!-- 第一行：客户名 + 阶段标签 -->
        <view class="event-header">
          <text class="event-name">{{item.customerName}}</text>
          <view class="stage-badge stage-{{item.stageClass}}">{{item.stage}}</view>
        </view>
        <!-- 第二行：拜访方式 -->
        <view class="event-way">{{item.visitWay}}</view>
      </view>

      <!-- 右栏：状态 -->
      <view class="event-status-area">
        <view wx:if="{{item.status === 'completed'}}" class="status-icon">✅</view>
        <view wx:elif="{{item.status === 'overdue'}}" class="status-badge overdue">逾期</view>
        <view wx:elif="{{item.status === 'adhoc'}}" class="status-badge adhoc">临时</view>
        <view wx:else class="status-badge pending">待执行</view>
      </view>
    </view>
  </view>
</view>
