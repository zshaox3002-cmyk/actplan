@import '/styles/variables.wxss';

.calendar-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-bg-page);
}

/* 视图切换 */
.view-toggle {
  padding: 16rpx 32rpx;
  background-color: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border);
}

.toggle-pill {
  display: flex;
  gap: 12rpx;
  background-color: var(--color-tab-bg);
  border-radius: var(--radius-tab);
  padding: 4rpx;
}

.toggle-item {
  flex: 1;
  padding: 12rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-tab-inactive-text);
  border-radius: var(--radius-tab-item);
  transition: all 0.2s ease;
}

.toggle-item.active {
  background-color: var(--color-tab-active-bg);
  color: var(--color-tab-active-text);
  font-weight: 500;
}

/* 日历容器 */
.calendar-container {
  flex-shrink: 0;
  background-color: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border);
  padding: 24rpx 32rpx;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.nav-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-text-primary);
  cursor: pointer;
}

.calendar-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

/* 周视图 */
.week-view {
  width: 100%;
}

.week-row {
  display: flex;
  gap: 8rpx;
  justify-content: space-between;
}

.day-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 8rpx;
  background-color: transparent;
  transition: all 0.2s ease;
  position: relative;
  min-height: 60rpx;
  justify-content: center;
}

.day-cell.selected {
  background-color: var(--color-primary);
  border-radius: 50%;
}

.day-cell.selected .day-number {
  color: #FFFFFF;
}

.day-cell.today {
  border: 2rpx solid var(--color-primary);
}

.day-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-bottom: 4rpx;
}

.day-number {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.day-mark {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
  position: absolute;
  bottom: 4rpx;
}

/* 月视图 */
.month-view {
  width: 100%;
}

.month-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.weekday-label {
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  padding: 8rpx 0;
}

.month-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.month-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 8rpx;
  background-color: transparent;
  position: relative;
  transition: all 0.2s ease;
}

.month-cell.other-month {
  opacity: 0.4;
}

.month-cell.today {
  border: 2rpx solid var(--color-primary);
}

.month-cell.selected {
  background-color: var(--color-primary);
}

.month-cell.selected .cell-day {
  color: #FFFFFF;
}

.cell-day {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.cell-mark {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background-color: var(--color-primary);
}

/* 事件列表 */
.events-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  padding: 24rpx 32rpx;
}

.events-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.events-date {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.events-count {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 事件卡片 - 三栏结构 */
.event-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-card);
  border: 1rpx solid var(--color-border);
  transition: all 0.2s ease;
}

.event-card.completed {
  opacity: 0.75;
}

.event-card:active {
  background-color: var(--color-primary-light);
}

/* 左栏：时间 */
.event-time {
  min-width: 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  text-align: right;
  flex-shrink: 0;
}

/* 中栏：主信息 */
.event-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.event-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.event-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.stage-badge {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.stage-badge.stage-meet {
  background-color: var(--color-bg-muted);
  color: var(--color-text-secondary);
}

.stage-badge.stage-comm {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

.stage-badge.stage-present {
  background-color: var(--color-warning-light);
  color: var(--color-warning);
}

.stage-badge.stage-closing {
  background-color: var(--color-warning-light);
  color: var(--color-warning);
}

.stage-badge.stage-deal {
  background-color: var(--color-success-light);
  color: var(--color-success);
}

.stage-badge.stage-lost {
  background-color: var(--color-danger-light);
  color: var(--color-danger);
}

.event-way {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 右栏：状态 */
.event-status-area {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.status-icon {
  font-size: 32rpx;
}

.status-badge {
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 8rpx;
  white-space: nowrap;
  height: 32rpx;
  display: flex;
  align-items: center;
}

.status-badge.pending {
  background-color: var(--color-primary);
  color: #FFFFFF;
}

.status-badge.completed {
  background-color: var(--color-success-light);
  color: var(--color-success);
}

.status-badge.overdue {
  background-color: var(--color-danger);
  color: #FFFFFF;
}

.status-badge.adhoc {
  background-color: var(--color-bg-muted);
  color: var(--color-text-secondary);
}
