/* components/fab-button/index.wxss */

.fab {
  position: fixed;
  right: var(--spacing-page);
  bottom: calc(var(--height-tabbar) + env(safe-area-inset-bottom) + var(--spacing-page));
  width: var(--size-fab);
  height: var(--size-fab);
  border-radius: 50%;
  background-color: var(--color-primary);
  box-shadow: var(--shadow-fab);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.fab:active {
  background-color: var(--color-primary-dark);
  transform: scale(0.95);
}

.fab-icon {
  font-size: 28px;
  color: #FFFFFF;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}
