/* components/record-card/index.wxss */

.record-card {
  padding: var(--spacing-card);
  margin-bottom: var(--spacing-card-gap);
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.customer-name {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* 成交状态徽章 */
.deal-badge {
  padding: 2px 8px;
  border-radius: var(--radius-badge);
}

.badge-deal {
  background-color: var(--color-badge-deal-bg);
}

.badge-deal .deal-text {
  color: var(--color-badge-deal-text);
}

.badge-no-deal {
  background-color: var(--color-bg-page);
}

.badge-no-deal .deal-text {
  color: var(--color-text-placeholder);
}

.deal-text {
  font-size: var(--font-size-helper);
  font-weight: var(--font-weight-medium);
}

/* 信息行 */
.record-info {
  margin-bottom: 6px;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 2px;
}

.info-icon {
  font-size: 13px;
  margin-right: 5px;
}

.info-text {
  font-size: var(--font-size-secondary);
  color: var(--color-text-secondary);
}

/* 摘要 */
.record-summary {
  margin-top: 6px;
  padding-top: 6px;
  border-top: 1px solid var(--color-border);
}

.summary-text {
  font-size: var(--font-size-secondary);
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 底部 */
.record-footer {
  display: flex;
  gap: 8px;
  margin-top: 6px;
}

.objection-tag {
  background-color: #FEF3C7;
  padding: 2px 8px;
  border-radius: var(--radius-badge);
}

.tag-text {
  font-size: var(--font-size-helper);
  color: var(--color-warning);
  font-weight: var(--font-weight-medium);
}
