<!-- customer-card/index.wxml -->
<view class="swipe-container customer-card-component"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd">

  <!-- 左滑操作区：预约 / 随手记 / 删除 -->
  <view class="swipe-actions">
    <view class="swipe-btn swipe-btn-plan" catchtap="onAddPlan">预约</view>
    <view class="swipe-btn swipe-btn-record" catchtap="onAddRecord">随手记</view>
    <view class="swipe-btn swipe-btn-delete" catchtap="onDeleteTap" data-id="{{customer.id}}">删除</view>
  </view>

  <!-- 卡片主体 -->
  <view class="customer-card"
        style="transform: translateX({{offsetX}}rpx);"
        catchtap="onCardTap"
        data-id="{{customer.id}}">

    <!-- 头部：姓名 + 交情 + 阶段标签 -->
    <view class="card-header">
      <text class="customer-name">{{customer.name}}</text>
      <text class="customer-intimacy" wx:if="{{customer.intimacy}}">{{customer.intimacy}}</text>
      <view class="stage-tag stage-{{_stageClass}}" wx:if="{{customer.stage}}">
        <text>{{customer.stage}}</text>
      </view>
    </view>

    <!-- 优先级行（有优先级时才显示） -->
    <view class="priority-row" wx:if="{{customer._priorityLevel && customer._priorityLevel !== 'none'}}">
      <view class="priority-tag priority-{{customer._priorityLevel}}">
        <text>{{customer._priorityLabel}}</text>
      </view>
      <text class="priority-reasons {{customer._isOverdue ? 'overdue' : ''}}" wx:if="{{customer._priorityReasons}}">{{customer._priorityReasons}}</text>
    </view>

    <!-- meta 信息：节奏视图显示节奏原因，默认视图显示下次跟进 -->
    <view class="card-meta">
      <view wx:if="{{viewContext === 'rhythm_attention' || viewContext === 'rhythm_advancing'}}">
        <text class="rhythm-reason">{{customer.rhythm_reason}}</text>
        <text class="rhythm-action" wx:if="{{customer.suggested_action}}">建议：{{customer.suggested_action}}</text>
      </view>
      <view wx:else class="meta-row {{customer._isOverdue ? 'overdue' : ''}}">
        <text class="meta-label">下次跟进</text>
        <text class="meta-value">{{customer._nextFollowText}}</text>
      </view>
    </view>

    <!-- 摘要 -->
    <view class="last-summary" wx:if="{{customer._lastSummary}}">
      <text>上次摘要：{{customer._lastSummary}}</text>
    </view>

  </view>
</view>
