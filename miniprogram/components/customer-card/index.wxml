<!-- customer-card/index.wxml — V4.0 固定4行 -->
<view class="customer-card customer-card-component"
      catchtap="onCardTap"
      data-id="{{customer.id}}">

  <!-- 行1：客户身份区 -->
  <view class="card-header">
    <text class="customer-name">{{customer.name}}</text>
    <text class="customer-relation" wx:if="{{customer.relation}}">{{customer.relation}}</text>
    <view class="header-right">
      <view class="stage-tag stage-{{_stageClass}}" wx:if="{{customer.stage}}">
        <text>{{customer.stage}}</text>
      </view>
    </view>
  </view>

  <!-- 行2：跟进信号区 -->
  <view class="signal-row">
    <view class="display-tag display-tag-{{customer._priorityDisplayClass}}">
      <text>{{customer._priorityDisplayLabel}}</text>
    </view>
    <view wx:for="{{customer._reasonTags}}" wx:key="*this" class="reason-chip-sm">
      <text>{{item}}</text>
    </view>
  </view>

  <!-- 行3：节奏视图 → rhythm_reason；默认视图 → 下次跟进 -->
  <view wx:if="{{viewContext === 'rhythm_attention' || viewContext === 'rhythm_advancing'}}"
        class="info-row">
    <text class="rhythm-reason">{{customer.rhythm_reason}}</text>
    <text class="rhythm-action" wx:if="{{customer.suggested_action}}">建议：{{customer.suggested_action}}</text>
  </view>
  <view wx:else class="info-row follow-row-{{customer._nextFollowClass}}">
    <text class="row-label">下次跟进</text>
    <text class="row-value">{{customer._nextFollowDisplay}}</text>
  </view>

  <!-- 行4：最近沟通区（两种视图均展示） -->
  <view class="info-row">
    <text class="row-label">最近沟通</text>
    <text class="row-value" wx:if="{{customer._lastContactDisplay}}">{{customer._lastContactDisplay}}</text>
    <text class="row-value row-value-empty" wx:else>暂无</text>
  </view>

</view>
