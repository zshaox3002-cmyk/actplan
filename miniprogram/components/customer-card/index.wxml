<!-- customer-card/index.wxml -->
<view class="swipe-container customer-card-component"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd">

  <!-- 删除按钮 -->
  <view class="delete-btn" catchtap="onDeleteTap" data-id="{{customer.id}}">
    <text class="delete-text">删除</text>
  </view>

  <!-- 卡片主体 -->
  <view class="customer-card"
        style="transform: translateX({{offsetX}}rpx);"
        catchtap="onCardTap"
        data-id="{{customer.id}}">

    <!-- 头部：姓名 + 阶段标签同行 -->
    <view class="card-header">
      <text class="customer-name">{{customer.name}}</text>
      <view class="stage-tag stage-{{_stageClass}}" wx:if="{{customer.stage}}">
        <text>{{customer.stage}}</text>
      </view>
    </view>

    <!-- 优先级行（有优先级时才显示） -->
    <view class="priority-row" wx:if="{{customer._priorityLevel && customer._priorityLevel !== 'none'}}">
      <view class="priority-tag priority-{{customer._priorityLevel}}">
        <text>{{customer._priorityLabel}}</text>
      </view>
      <text class="priority-reasons {{customer._isOverdue ? 'overdue' : ''}}" wx:if="{{customer._priorityReasons}}">{{customer._priorityReasons}}</text>
    </view>

    <!-- 客户属性标签 -->
    <view class="custom-tags" wx:if="{{customer.tags && customer.tags.length > 0}}">
      <view class="custom-tag" wx:for="{{customer.tags}}" wx:key="*this">
        <text>{{item}}</text>
      </view>
    </view>

    <!-- meta 信息：上下两行 -->
    <view class="card-meta">
      <view class="meta-row">
        <text class="meta-label">上次沟通</text>
        <text class="meta-value">{{customer._lastVisitText}}</text>
      </view>
      <view class="meta-row {{customer._isOverdue ? 'overdue' : ''}}">
        <text class="meta-label">下次跟进</text>
        <text class="meta-value">{{customer._nextFollowText}}</text>
      </view>
    </view>

    <!-- 摘要 -->
    <view class="last-summary" wx:if="{{customer._lastSummary}}">
      <text>上次摘要：{{customer._lastSummary}}</text>
    </view>

    <!-- 操作按钮 -->
    <view class="card-actions">
      <view class="action-btn" catchtap="onAddPlan" data-id="{{customer.id}}" data-name="{{customer.name}}">预约</view>
      <view class="action-btn" catchtap="onAddRecord" data-id="{{customer.id}}" data-name="{{customer.name}}">随手记</view>
    </view>

  </view>
</view>
