/* customer-card 组件 — 左侧色条 + 底色区分等级 + 左滑删除 */

/* ---- 滑动容器 ---- */
.swipe-container {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

/* ---- 卡片主体 ---- */
.customer-card {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  border-radius: 16rpx;
  margin-bottom: 0;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.25s ease;
}

/* ---- 删除按钮 ---- */
.delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: #E74C3C;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 16rpx 16rpx 0;
  z-index: 0;
}

.delete-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ---- 左侧色条 ---- */
.rank-bar {
  width: 10rpx;
  flex-shrink: 0;
  border-radius: 16rpx 0 0 16rpx;
}

/* ---- 等级底色 + 色条颜色 ---- */
.rank-red { background: #FFF5F5; }
.rank-red .rank-bar { background: #E74C3C; }

.rank-green { background: #F0FDF4; }
.rank-green .rank-bar { background: #27AE60; }

.rank-brown { background: #FFFBEB; }
.rank-brown .rank-bar { background: #92400E; }

.rank-yellow { background: #FFFBEB; }
.rank-yellow .rank-bar { background: #F39C12; }

/* ---- 内容区 ---- */
.card-content {
  flex: 1;
  padding: 20rpx 20rpx 16rpx;
}

/* ---- 第一行：姓名 + 阶段 ---- */
.card-row-1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.customer-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

/* 阶段徽章 */
.stage-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.6;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.stage-need, .stage-touch {
  background: #E8F1FC;
  color: #1A6FD4;
}

.stage-deal {
  background: #DCFCE7;
  color: #27AE60;
}

.stage-reject {
  background: #FEE2E2;
  color: #E74C3C;
}

/* ---- 第二行：拜访 · 最近 ---- */
.card-row-2 {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-meta {
  font-size: 22rpx;
  color: #6B7280;
  white-space: nowrap;
}

.card-dot {
  font-size: 22rpx;
  color: #D1D5DB;
}

/* ---- 第三行：信息标签 ---- */
.card-row-3 {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.info-tag {
  background: rgba(0, 0, 0, 0.04);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.info-tag text {
  font-size: 20rpx;
  color: #9CA3AF;
}
