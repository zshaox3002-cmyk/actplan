/* components/metric-card/index.wxss */

.metric-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 16rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.metric-dot {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A2E;
  line-height: 1.2;
}

.metric-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}
