<view class="empty-state">
  <text class="empty-icon" wx:if="{{icon}}">{{icon}}</text>
  <text class="empty-text">{{text}}</text>
  <text class="empty-sub" wx:if="{{subText}}">{{subText}}</text>
  <view class="empty-action" wx:if="{{actionLabel}}" bindtap="onActionTap">
    <text class="action-text">{{actionLabel}}</text>
  </view>
</view>
