<!-- components/plan-card/index.wxml -->
<view class="plan-card card {{plan.status === '已完成' ? 'completed' : ''}}" bindtap="{{plan.status === '已完成' ? 'onCardTap' : ''}}">
  <!-- 顶部：客户名 + 状态徽章 -->
  <view class="plan-header">
    <text class="customer-name">{{customerName || '未知客户'}}</text>
    <view class="status-badge {{plan.status === '已完成' ? 'badge-completed' : 'badge-pending'}}">
      <text class="status-text">{{plan.status}}</text>
    </view>
  </view>

  <!-- 中部：拜访方式 + 日期 -->
  <view class="plan-info">
    <view class="info-row">
      <text class="info-icon">📅</text>
      <text class="info-text">{{plan.plan_date}}<block wx:if="{{plan.plan_time}}"> · {{plan.plan_time}}</block></text>
    </view>
    <view class="info-row">
      <text class="info-icon">💬</text>
      <text class="info-text">{{plan.visit_way}}</text>
    </view>
  </view>

  <!-- 底部：操作按钮 -->
  <view class="plan-actions" wx:if="{{plan.status !== '已完成'}}">
    <view class="action-btn btn-execute" bindtap="onExecute">
      <text class="action-text">执行</text>
    </view>
    <view class="action-btn btn-edit" bindtap="onEdit">
      <text class="action-text">修改</text>
    </view>
    <view class="action-btn btn-delete" bindtap="onDelete">
      <text class="action-text">删除</text>
    </view>
  </view>

  <!-- 已完成：查看记录提示 -->
  <view class="record-hint" wx:if="{{plan.status === '已完成'}}">
    <text class="record-hint-text">查看拜访记录</text>
    <text class="record-hint-arrow">›</text>
  </view>
</view>
