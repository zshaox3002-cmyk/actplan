/* components/plan-card/index.wxss */

.plan-card {
  padding: var(--spacing-card);
  margin-bottom: var(--spacing-card-gap);
}

/* ---- 顶部 ---- */
.plan-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}

.customer-name {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

/* ---- 状态徽章 ---- */
.status-badge {
  padding: var(--spacing-badge-py) var(--spacing-badge-px);
  border-radius: var(--radius-badge);
}

.badge-pending {
  background-color: var(--color-badge-need-bg);
}

.badge-pending .status-text {
  color: var(--color-badge-need-text);
}

.badge-completed {
  background-color: var(--color-badge-deal-bg);
}

.badge-completed .status-text {
  color: var(--color-badge-deal-text);
}

.status-text {
  font-size: var(--font-size-helper);
  font-weight: var(--font-weight-medium);
}

/* ---- 信息行 ---- */
.plan-info {
  margin-bottom: 12px;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 4px;
}

.info-icon {
  font-size: 14px;
  margin-right: 6px;
}

.info-text {
  font-size: var(--font-size-secondary);
  color: var(--color-text-secondary);
}

/* ---- 操作按钮 ---- */
.plan-actions {
  display: flex;
  gap: 10px;
}

.action-btn {
  flex: 1;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-execute {
  background-color: var(--color-primary);
}

.btn-execute .action-text {
  color: #FFFFFF;
  font-weight: var(--font-weight-semibold);
}

.btn-execute:active {
  background-color: var(--color-primary-dark);
}

.btn-delete {
  background-color: var(--color-bg-page);
  border: 1px solid var(--color-border);
}

.btn-delete .action-text {
  color: var(--color-text-secondary);
}

.btn-delete:active {
  background-color: var(--color-border);
}

.btn-edit {
  background-color: var(--color-primary-light);
}

.btn-edit .action-text {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.btn-edit:active {
  background-color: var(--color-border);
}

.action-text {
  font-size: var(--font-size-secondary);
}

/* ---- 已完成卡片视觉暗示 ---- */
.plan-card.completed {
  border-left: 6rpx solid #16A34A;
  box-shadow: 0 2rpx 12rpx rgba(22,163,74,0.08);
}
.record-hint {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0FDF4;
}
.record-hint-text { font-size: 24rpx; color: #16A34A; }
.record-hint-arrow { font-size: 28rpx; color: #16A34A; }
