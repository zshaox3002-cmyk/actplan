<!-- components/week-calendar/index.wxml -->
<view class="week-calendar">
  <!-- 导航栏：上一周 / 周标签 / 下一周 -->
  <view class="week-nav">
    <view class="week-nav-btn" bindtap="onPrevWeek">
      <text class="nav-arrow">‹</text>
    </view>
    <text class="week-label">{{weekLabel}}</text>
    <view class="week-nav-btn" bindtap="onNextWeek">
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <!-- 星期头 -->
  <view class="week-header">
    <view class="week-header-cell" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">
      <text class="header-text">{{item}}</text>
    </view>
  </view>

  <!-- 日期行 -->
  <view class="week-body">
    <view
      class="day-cell {{item.date === selectedDate ? 'day-selected' : ''}} {{item.isToday ? 'day-today' : ''}}"
      wx:for="{{weekDays}}"
      wx:key="date"
      data-date="{{item.date}}"
      bindtap="onDayTap"
    >
      <text class="day-number">{{item.day}}</text>
      <view class="day-dot" wx:if="{{markedDates.indexOf(item.date) >= 0}}"></view>
    </view>
  </view>
</view>
