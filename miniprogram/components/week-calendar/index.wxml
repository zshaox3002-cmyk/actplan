<!-- components/week-calendar/index.wxml -->
<view class="week-calendar">
  <!-- 导航栏：上一期 / 标签 / 切换视图 / 下一期 -->
  <view class="week-nav">
    <view class="week-nav-btn" bindtap="onPrevWeek">
      <text class="nav-arrow">‹</text>
    </view>
    <view class="nav-center">
      <text class="week-label">{{viewMode === 'week' ? weekLabel : monthLabel}}</text>
      <view class="view-toggle-group">
        <view class="view-toggle-item {{viewMode === 'week' ? 'view-toggle-item--active' : ''}}" data-mode="week" bindtap="onToggleView">
          <text class="view-toggle-item-text">周</text>
        </view>
        <view class="view-toggle-item {{viewMode === 'month' ? 'view-toggle-item--active' : ''}}" data-mode="month" bindtap="onToggleView">
          <text class="view-toggle-item-text">月</text>
        </view>
      </view>
    </view>
    <view class="week-nav-btn" bindtap="onNextWeek">
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <!-- 星期头（两种视图共用） -->
  <view class="week-header">
    <view class="week-header-cell" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">
      <text class="header-text">{{item}}</text>
    </view>
  </view>

  <!-- 周视图：日期行 -->
  <view class="week-body" wx:if="{{viewMode === 'week'}}">
    <view
      class="day-cell {{item.date === selectedDate ? 'day-selected' : ''}} {{item.isToday ? 'day-today' : ''}}"
      wx:for="{{weekDays}}"
      wx:key="date"
      data-date="{{item.date}}"
      bindtap="onDayTap"
    >
      <text class="day-number">{{item.day}}</text>
      <view class="day-dot" wx:if="{{item.isMarked}}"></view>
    </view>
  </view>

  <!-- 月视图：日期网格 -->
  <view class="month-body" wx:else>
    <view
      class="month-cell {{item.date === selectedDate ? 'day-selected' : ''}} {{item.isToday ? 'day-today' : ''}} {{item.isCurrentMonth ? '' : 'month-cell--faded'}}"
      wx:for="{{monthDays}}"
      wx:key="date"
      data-date="{{item.date}}"
      bindtap="onDayTap"
    >
      <text class="day-number">{{item.day}}</text>
      <view class="day-dot" wx:if="{{item.isMarked}}"></view>
    </view>
  </view>
</view>
