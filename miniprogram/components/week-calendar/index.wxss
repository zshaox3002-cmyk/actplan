/* components/week-calendar/index.wxss */

.week-calendar {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 12px 8px;
}

/* ---- 导航栏 ---- */
.week-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8px;
  margin-bottom: 12px;
}

.week-nav-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-arrow {
  font-size: 22px;
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}

.nav-center {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.week-label {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.view-toggle-group {
  display: flex;
  background: var(--color-primary-light);
  border-radius: 8rpx;
  overflow: hidden;
}

.view-toggle-item {
  padding: 4rpx 20rpx;
}

.view-toggle-item--active {
  background: var(--color-primary);
  border-radius: 8rpx;
}

.view-toggle-item-text {
  font-size: var(--font-size-helper);
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.view-toggle-item--active .view-toggle-item-text {
  color: #FFFFFF;
}

/* ---- 星期头 ---- */
.week-header {
  display: flex;
  margin-bottom: 4px;
}

.week-header-cell {
  flex: 1;
  text-align: center;
}

.header-text {
  font-size: var(--font-size-helper);
  color: var(--color-text-placeholder);
  font-weight: var(--font-weight-medium);
}

/* ---- 周视图：日期行 ---- */
.week-body {
  display: flex;
}

.day-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 44px;
  border-radius: 12px;
  position: relative;
  transition: background-color 0.2s;
}

.day-cell:active {
  background-color: var(--color-primary-light);
}

.day-number {
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-medium);
  line-height: 20px;
}

.day-selected {
  background-color: var(--color-primary);
}

.day-selected .day-number {
  color: #FFFFFF;
  font-weight: var(--font-weight-semibold);
}

.day-today .day-number {
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}

.day-selected.day-today .day-number {
  color: #FFFFFF;
}

/* ---- 日期下方圆点（有计划的日期标记） ---- */
.day-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: var(--color-primary);
  margin-top: 2px;
}

.day-selected .day-dot {
  background-color: #FFFFFF;
}

/* ---- 月视图：日期网格 ---- */
.month-body {
  display: flex;
  flex-wrap: wrap;
}

.month-cell {
  width: calc(100% / 7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 48px;
  border-radius: 12px;
  box-sizing: border-box;
}

.month-cell:active {
  background-color: var(--color-primary-light);
}

.month-cell--faded .day-number {
  color: var(--color-text-placeholder);
}

.month-cell--faded .day-dot {
  background-color: var(--color-text-placeholder);
}

