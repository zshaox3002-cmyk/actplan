/* filter-bar 组件 — 内联展开下拉菜单 */

.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  position: relative;
}

/* ---- 筛选包装器 ---- */
.filter-wrapper {
  position: relative;
  flex: 1;
}

/* ---- 触发器按钮 ---- */
.filter-select {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 10rpx;
  padding: 0 16rpx;
  height: 64rpx;
  gap: 8rpx;
}

.filter-label {
  font-size: 22rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

.filter-value {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A2E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #9CA3AF;
  transition: transform 0.2s;
  flex-shrink: 0;
}

.arrow-up {
  transform: rotate(180deg);
}

/* ---- 下拉菜单 ---- */
.dropdown-menu {
  position: absolute;
  top: 68rpx;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.10);
  z-index: 999;
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.2s ease, opacity 0.15s ease;
}

.dropdown-show {
  max-height: 480rpx;
  opacity: 1;
}

.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 20rpx;
  font-size: 26rpx;
  color: #1A1A2E;
  border-bottom: 1rpx solid #F3F4F6;
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item-active {
  background: #E8F1FC;
  color: #1A6FD4;
  font-weight: 500;
}

.dropdown-check {
  color: #1A6FD4;
  font-size: 26rpx;
}

/* ---- 全屏透明遮罩 ---- */
.dropdown-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
}

.overlay-show {
  display: block;
}
