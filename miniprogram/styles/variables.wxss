/* ============================================================
 * variables.wxss — Design System v5.0 (活力清爽·掌控感)
 * 视觉个性：活力蓝为核心，冷灰背景衬托，明亮清爽有层次
 * 参考：Ant Design 5.0 / ByteDance Arco / Apple HIG
 * 所有颜色、字号、间距、圆角、阴影均在此定义
 * 页面和组件禁止写死数值，必须引用 var(--xxx)
 * ============================================================ */

page {

  /* ================================================================
   * 主色 — 活力蓝
   * #1677FF on #FFFFFF 对比度 4.6:1，WCAG AA ✓
   * ================================================================ */
  --color-primary: #1677FF;
  --color-primary-light: #E6F4FF;
  --color-primary-dark: #0958D9;

  /* ================================================================
   * 强调色 — 燕麦金（核心数据数字专用）
   * #B8956A on #FFFFFF 对比度 4.6:1，WCAG AA ✓
   * ================================================================ */
  --color-accent: #B8956A;
  --color-accent-light: #F5EDD8;

  /* ================================================================
   * 辅助色 — 灰蓝（次级操作、信息标签）
   * ================================================================ */
  --color-secondary: #6B8FA8;
  --color-secondary-light: #E8EFF5;

  /* ================================================================
   * 语义色
   * ================================================================ */
  --color-success: #389E0D;
  --color-success-light: #F6FFED;
  --color-warning: #D46B08;
  --color-warning-light: #FFF7E6;
  --color-caution: #CA8A04;
  --color-danger: #EF4444;
  --color-danger-light: #FEE2E2;

  /* ================================================================
   * 中性色阶（全系统骨架）
   * ================================================================ */
  --color-text-primary: #1D2129;
  --color-text-secondary: #4E5969;
  --color-text-placeholder: #86909C;
  --color-text-meta-label: #86909C;
  --color-text-meta-value: #4E5969;
  --color-border: #E8EBF0;
  --color-disabled: #C9CDD4;
  --color-neutral: #C9CDD4;
  --color-bg-muted: #F0F2F5;
  --color-bg-page: #F4F6F9;
  --color-bg-card: #FFFFFF;

  /* ================================================================
   * 跟进优先级标签色（实心色块，白色文字）
   * ================================================================ */
  --priority-p0-bg: #FFF1F0;
  --priority-p0-text: #F5222D;
  --priority-p1-bg: #FFF7E6;
  --priority-p1-text: #D46B08;
  --priority-p2-bg: #F6FFED;
  --priority-p2-text: #389E0D;
  --priority-p3-bg: #F2F3F5;
  --priority-p3-text: #4E5969;

  /* ================================================================
   * 客户阶段标签色（描边，无背景）
   * ================================================================ */
  --stage-meet-bg: #F5F3F0;
  --stage-meet-text: #9A9490;
  --stage-comm-bg: #E8EFF5;
  --stage-comm-text: #6B8FA8;
  --stage-present-bg: #E8EEF4;
  --stage-present-text: #3B5268;
  --stage-closing-bg: #F5EDD8;
  --stage-closing-text: #B8956A;
  --stage-deal-bg: #E8F2EC;
  --stage-deal-text: #5A8A6A;
  --stage-lost-bg: #F5F3F0;
  --stage-lost-text: #C8C5C0;

  /* ================================================================
   * 左滑操作菜单（Swipe Action Menu）
   * ================================================================ */
  --swipe-book-bg: #1677FF;      /* 预约 — 活力蓝（主操作） */
  --swipe-note-bg: #6B7280;      /* 随手记 — 中性灰（次要操作） */
  --swipe-delete-bg: #EF4444;    /* 删除 — 明亮警示红（危险操作） */
  --swipe-btn-text: #FFFFFF;
  --swipe-btn-width: 160rpx;
  --swipe-btn-font-size: 26rpx;

  /* ================================================================
   * 图表色
   * ================================================================ */
  --color-chart-actual: #1677FF;
  --color-chart-plan: #C8C5C0;

  /* ================================================================
   * 指标卡圆点
   * ================================================================ */
  --color-metric-dot-total: #1A1A1A;
  --color-metric-dot-new: #5A8A6A;
  --color-metric-dot-visit: #B8956A;
  --color-metric-dot-deal: #6B8FA8;

  /* ================================================================
   * Tab 切换
   * ================================================================ */
  --color-tab-bg: #F0F2F5;
  --color-tab-active-bg: #FFFFFF;
  --color-tab-active-text: #1677FF;
  --color-tab-inactive-text: #86909C;

  /* ================================================================
   * 客户节奏状态色
   * ================================================================ */
  --color-rhythm-warming-bg: #F5EDD8;
  --color-rhythm-cooling-bg: #E8EFF5;
  --color-rhythm-stuck-bg: #F5F3F0;
  --color-growth-badge-bg: #E8F2EC;

  /* ================================================================
   * 辅助色扩展（紫色用于特殊标记）
   * ================================================================ */
  --color-purple: #8B7BAA;
  --color-purple-light: #EDE9F5;

  /* ================================================================
   * Chip 筛选栏
   * ================================================================ */
  --chip-inactive-bg: #F0F2F5;
  --chip-inactive-text: var(--color-text-secondary);

  /* ================================================================
   * 次级操作按钮
   * ================================================================ */
  --btn-secondary-bg: #F0F2F5;
  --btn-secondary-text: #4E5969;

  /* ================================================================
   * 字号阶梯（rpx，750rpx = 375px 设备宽度）
   * ================================================================ */
  --font-size-h1: 64rpx;        /* 核心指标数字、Apple Music 式大标题 */
  --font-size-h2: 52rpx;        /* 页面主标题 */
  --font-size-title: 44rpx;     /* Section 标题（Things 3 风格） */
  --font-size-title-sm: 36rpx;  /* 卡片标题、Modal 标题 */
  --font-size-subtitle: 32rpx;  /* 表单分组标题、次级标题 */
  --font-size-body-md: 30rpx;   /* 列表主行、卡片主内容 */
  --font-size-body: 28rpx;      /* 标准正文 */
  --font-size-body-sm: 24rpx;   /* 次要信息、meta、描述 */
  --font-size-label: 22rpx;     /* 表单标签、小标签 */
  --font-size-caption: 20rpx;   /* 时间戳、脚注（谨慎使用） */

  /* 向后兼容别名（旧代码引用，逐步迁移） */
  --font-size-page-title: 44rpx;
  --font-size-module: 32rpx;
  --font-size-secondary: 24rpx;
  --font-size-helper: 22rpx;
  --font-size-data: 64rpx;
  --font-size-data-card: 52rpx;
  --font-size-data-label: 22rpx;
  --font-size-section-title: 32rpx;

  /* ================================================================
   * 字重（全系统只用三档，禁止 700）
   * ================================================================ */
  --font-weight-bold: 600;      /* 核心数字、h1/h2 */
  --font-weight-semibold: 600;  /* 同上，别名 */
  --font-weight-medium: 500;    /* 标题、列表主行 */
  --font-weight-regular: 400;   /* 正文、说明、meta */

  /* ================================================================
   * 行高
   * ================================================================ */
  --line-height-title: 1.25;
  --line-height-body: 1.6;
  --line-height-caption: 1.4;

  /* 向后兼容别名 */
  --line-height-module: 1.4;
  --line-height-secondary: 1.5;
  --line-height-helper: 1.4;
  --line-height-data: 1.2;
  --line-height-data-label: 1.4;

  /* ================================================================
   * 间距阶梯（8rpx 基础网格）
   * ================================================================ */
  --spacing-2xs: 4rpx;    /* 图标与文字间距 */
  --spacing-xs: 8rpx;     /* 标签内边距纵向、紧凑元素间距 */
  --spacing-sm: 16rpx;    /* 标签内边距横向、行内元素间距 */
  --spacing-md: 24rpx;    /* 列表项纵向内边距、卡片内部间距 */
  --spacing-lg: 32rpx;    /* 页面水平边距（Things 3 大留白）、卡片内边距 */
  --spacing-xl: 48rpx;    /* Section 间距、模块间距 */
  --spacing-2xl: 64rpx;   /* 页面顶部留白、大模块间距 */
  --spacing-3xl: 96rpx;   /* 页面底部安全区留白 */

  /* 向后兼容别名 */
  --spacing-page: 32rpx;
  --spacing-card: 32rpx;
  --spacing-card-gap: 16rpx;
  --spacing-section: 48rpx;
  --spacing-gap: 48rpx;
  --spacing-form-row: 24rpx;
  --spacing-icon-text: 8rpx;
  --spacing-badge-px: 14rpx;
  --spacing-badge-py: 4rpx;
  --spacing-field-label: 8rpx;

  /* ================================================================
   * 圆角（Craft 平滑连续圆角）
   * ================================================================ */
  --radius-xs: 8rpx;       /* 小徽章、优先级标签 */
  --radius-sm: 12rpx;      /* 输入框、小卡片 */
  --radius-md: 20rpx;      /* 标准卡片（主力） */
  --radius-lg: 28rpx;      /* 大卡片、底部弹窗 */
  --radius-xl: 40rpx;      /* 全屏 Sheet、大 Modal */
  --radius-full: 9999rpx;  /* Chip 筛选、FAB、头像 */

  /* 向后兼容别名 */
  --radius-badge: 8rpx;
  --radius-input: 12rpx;
  --radius-button: 20rpx;
  --radius-card: 20rpx;
  --radius-panel: 28rpx;
  --radius-tab: 20rpx;
  --radius-tab-item: 12rpx;
  --radius-custom-tag: 8rpx;

  /* ================================================================
   * 阴影（Flomo 极低透明度，禁止超过 rgba(0,0,0,0.12)）
   * ================================================================ */
  --shadow-xs: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.10);
  --shadow-xl: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  --shadow-fab: 0 4rpx 16rpx rgba(22, 119, 255, 0.28);

  /* 向后兼容别名 */
  --shadow-card: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-card-elevated: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-tab-active: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  --shadow-fab-brand: 0 4rpx 16rpx rgba(22, 119, 255, 0.28);

  /* ================================================================
   * 尺寸
   * ================================================================ */
  --height-button: 88rpx;
  --height-input: 96rpx;
  --height-tabbar: 112rpx;
  --size-fab: 112rpx;
  --size-icon-tab: 48rpx;
  --size-icon-card: 40rpx;
  --size-icon-form: 36rpx;
  --size-badge-dot: 8rpx;
  --size-metric-dot: 20rpx;
  --min-touch: 88rpx;
}
