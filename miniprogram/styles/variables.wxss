/* ============================================================
* variables.wxss — Design System v2.0
* 所有颜色、字号、间距、圆角、阴影均在此定义
* 页面和组件禁止写死数值，必须引用 var(--xxx)
* ============================================================ */

page {
  /* ---- 主色（蓝绿） ---- */
  --color-primary: #0EA5A4;
  --color-primary-light: #CCFBF1;
  --color-primary-dark: #0F766E;

  /* ---- 辅助色 ---- */
  --color-secondary: #2563EB;
  --color-secondary-light: #DBEAFE;
  --color-success: #10B981;
  --color-success-light: #ECFDF5;
  --color-warning: #F59E0B;
  --color-warning-light: #FFFBEB;
  --color-danger: #EF4444;
  --color-danger-light: #FEF2F2;
  --color-neutral: #CBD5E1;

  /* ---- 中性色 ---- */
  --color-bg-page: #F4F7FB;
  --color-bg-card: #FFFFFF;
  --color-text-primary: #0F172A;
  --color-text-secondary: #64748B;
  --color-text-placeholder: #94A3B8;
  --color-border: #E5EAF2;
  --color-disabled: #CBD5E1;

  /* ---- 跟进优先级 ---- */
  --priority-p0-bg: #EF4444;
  --priority-p0-text: #FFFFFF;
  --priority-p1-bg: #F59E0B;
  --priority-p1-text: #FFFFFF;
  --priority-p2-bg: #EAB308;
  --priority-p2-text: #FFFFFF;
  --priority-p3-bg: #CBD5E1;
  --priority-p3-text: #FFFFFF;

  /* ---- 客户阶段 ---- */
  --stage-meet-bg: #F1F5F9;
  --stage-meet-text: #64748B;
  --stage-comm-bg: #CCFBF1;
  --stage-comm-text: #0F766E;
  --stage-present-bg: #DBEAFE;
  --stage-present-text: #2563EB;
  --stage-closing-bg: #FFF7ED;
  --stage-closing-text: #F59E0B;
  --stage-deal-bg: #DCFCE7;
  --stage-deal-text: #10B981;
  --stage-lost-bg: #F1F5F9;
  --stage-lost-text: #94A3B8;

  /* ---- 图表 ---- */
  --color-chart-actual: #0EA5A4;
  --color-chart-plan: #CBD5E1;

  /* ---- 指标卡圆点 ---- */
  --color-metric-dot-total: #0F172A;
  --color-metric-dot-new: #10B981;
  --color-metric-dot-visit: #F59E0B;
  --color-metric-dot-deal: #8B5CF6;

  /* ---- Tab 切换 ---- */
  --color-tab-bg: #F0F4F8;
  --color-tab-active-bg: #FFFFFF;
  --color-tab-active-text: #0EA5A4;
  --color-tab-inactive-text: #94A3B8;

  /* ---- 字号 ---- */
  --font-size-title: 18px;
  --font-size-page-title: 18px;
  --font-size-module: 16px;
  --font-size-body: 14px;
  --font-size-secondary: 13px;
  --font-size-helper: 12px;
  --font-size-data: 28px;
  --font-size-data-label: 12px;
  --font-size-section-title: 16px;

  /* ---- 字重 ---- */
  --font-weight-bold: 700;
  --font-weight-semibold: 600;
  --font-weight-medium: 500;
  --font-weight-regular: 400;

  /* ---- 行高 ---- */
  --line-height-title: 28px;
  --line-height-module: 24px;
  --line-height-body: 22px;
  --line-height-secondary: 20px;
  --line-height-helper: 18px;
  --line-height-data: 36px;
  --line-height-data-label: 18px;

  /* ---- 间距 ---- */
  --spacing-page: 16px;
  --spacing-card: 16px;
  --spacing-card-gap: 12px;
  --spacing-section: 20px;
  --spacing-form-row: 16px;
  --spacing-icon-text: 4px;
  --spacing-badge-px: 8px;
  --spacing-badge-py: 4px;
  --spacing-field-label: 6px;

  /* ---- 圆角 ---- */
  --radius-card: 12px;
  --radius-badge: 6px;
  --radius-input: 8px;
  --radius-button: 10px;
  --radius-panel: 16px;
  --radius-tab: 12rpx;
  --radius-tab-item: 10rpx;

  /* ---- 阴影 ---- */
  --shadow-card: 0 2px 8px rgba(15, 23, 42, 0.04);
  --shadow-card-elevated: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
  --shadow-tab-active: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  --shadow-fab: 0 4px 16px rgba(14, 165, 164, 0.35);

  /* ---- 尺寸 ---- */
  --height-button: 44px;
  --height-input: 48px;
  --height-tabbar: 56px;
  --size-fab: 56px;
  --size-icon-tab: 24px;
  --size-icon-card: 20px;
  --size-icon-form: 18px;
  --size-badge-dot: 4px;
  --size-metric-dot: 20rpx;
  --min-touch: 44px;
}
